<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8">

  <title>Order Details</title>

  <link rel="stylesheet" href="/css/adminSidebar.css">
  <link rel="stylesheet" href="/css/admin-order-details.css">

</head>

<body>

<%- include("../partials/admin-header") %>

<div class="layout">

  <%- include("../partials/admin-sidebar") %>

  <div class="main-content">

    <h1>Order Details</h1>

    <!-- TOP SECTION -->

    <div class="details-grid">

      <!-- ORDER INFO -->

      <div class="card">

        <h3>Order Information</h3>

        <p>
          <strong>Order ID:</strong>
          <%= order.orderId %>
        </p>

        <p>
          <strong>Order Date:</strong>
          <%= new Date(order.createdAt).toLocaleDateString() %>
        </p>

        <p>
          <strong>Status:</strong>

          <span class="status-badge status-<%= order.orderStatus.toLowerCase() %>">
            <%= order.orderStatus %>
          </span>

        </p>

        <p>
          <strong>Payment Method:</strong>
          <%= order.paymentMethod %>
        </p>

        <p>
          <strong>Payment Status:</strong>
          <%= order.paymentStatus %>
        </p>

      </div>

      <!-- CUSTOMER DETAILS -->

      <div class="card">

        <h3>Customer Details</h3>

        <p>
          <strong>Name:</strong>
          <%= order.user.name %>
        </p>

        <p>
          <strong>Email:</strong>
          <%= order.user.email %>
        </p>

        <p>
          <strong>Phone:</strong>
          <%= order.address.phone %>
        </p>

        <p>
          <strong>Address:</strong>
          <%= order.address.house %>,
          <%= order.address.area %>,
          <%= order.address.city %>,
          <%= order.address.state %>
        </p>

        <p>
          <strong>PIN:</strong>
          <%= order.address.pincode %>
        </p>

      </div>

    </div>

    <!-- ORDERED PRODUCTS -->

    <div class="card">

      <h3>Ordered Products</h3>

      <% order.items.forEach(function(item){ %>

        <div class="product-row">

          <div class="product-left">

            <img
              src="/images/<%= item.product.images[0] %>"
              alt="<%= item.product.name %>"
              class="product-image"
            >

            <div class="product-info">

              <h4><%= item.product.name %></h4>

              <p>
                Quantity : <%= item.quantity %>
              </p>

              <p>
                Price : ₹<%= item.price %>
              </p>

              <p>
                <strong>Status :</strong>

                <span class="status-badge status-<%= item.status.toLowerCase().replace(' ','-') %>">
                  <%= item.status %>
                </span>
              </p>

            </div>

          </div>

          <div class="product-total">
            ₹<%= item.price * item.quantity %>
          </div>

        </div>

      <% }) %>

    </div>

<div class="bottom-grid">

  <!-- PRICE SUMMARY -->

    <div class="card">

      <h3>Price Summary</h3>

      <div class="summary-box">

        <div class="summary-row">
          <span>Subtotal</span>
          <span>₹<%= order.subtotal %></span>
        </div>

        <div class="summary-row">
          <span>Shipping</span>
          <span>₹<%= order.shipping %></span>
        </div>

        <div class="summary-row">
          <span>Discount</span>
          <span>₹<%= order.discount %></span>
        </div>

        <div class="summary-row total-row">
          <span>Total</span>
          <span>₹<%= order.total %></span>
        </div>

      </div>

    </div>

    <!-- STATUS UPDATE -->

   <div class="card">
      <h3>Update Order Status</h3>


<%
const requestedItems = order.items.filter(
    item => item.status === "Return Requested"
);

const hasReturnRequest = requestedItems.length > 0;


const isBulkReturn =
    order.items.length > 1 &&
    requestedItems.length === order.items.length;
%>

<% if(hasReturnRequest){ %>


<h3>
    <%= isBulkReturn ? "Bulk Return Request" : "Product Return Request" %>
</h3>



<% if(isBulkReturn){ %>

<div class="return-box">

    <p>
        All products in this order have been requested for return.
    </p>

    <p>
        <strong>Reason:</strong>
        <%= requestedItems[0].returnReason %>
    </p>

    <div class="return-actions">

        <form
            action="/admin/orders/<%= order._id %>/approve-return-all"
            method="POST"
        >
            <button class="approve-btn">
                Approve All
            </button>
        </form>

        <form
            action="/admin/orders/<%= order._id %>/reject-return-all"
            method="POST"
        >
            <button class="reject-btn">
                Reject All
            </button>
        </form>

    </div>

</div>

<% } else { %>


<% requestedItems.forEach(function(item){ %>

    <div class="return-box">

        <h4><%= item.product.name %></h4>

        <p>
            <strong>Reason:</strong>
            <%= item.returnReason %>
        </p>

        <div class="return-actions">

            <form
                action="/admin/orders/<%= order._id %>/product/<%= item.product._id %>/approve-return"
                method="POST"
            >
                <button class="approve-btn">
                    Approve Return
                </button>
            </form>

            <form
                action="/admin/orders/<%= order._id %>/product/<%= item.product._id %>/reject-return"
                method="POST"
            >
                <button class="reject-btn">
                    Reject Return
                </button>
            </form>

        </div>

    </div>

<% }) %>
<% } %>

<% } else { %>

<!--  Update Status Form -->
  <% if (order.orderStatus === "Delivered" || order.orderStatus === "Cancelled" || order.orderStatus === "Returned") { %>
        <p style="color: #7a563f; font-weight: 600; margin-top: 15px;">
              <% if(order.orderStatus === "Delivered"){ %>

              <p class="info-message">
                No pending return requests.
              </p>

              <% } else if(order.orderStatus === "Returned"){ %>

              <p class="info-message">
                All products have been returned.
              </p>

              <% } else if(order.orderStatus === "Cancelled"){ %>

              <p class="info-message">
                This order has been cancelled.
              </p>

              <% } %>


</p>
      <% } else { %>
        
        <form
          action="/admin/orders/<%= order._id %>/status"
          method="POST"
          class="status-form"
        >
          <select name="status" class="status-select">

            <% if (order.orderStatus === "Placed") { %>
              <option value="Placed" selected disabled>Placed (Current Status)</option>
              <option value="Processing">Move to Processing</option>
              <option value="Cancelled">Cancel Order</option>
            <% } %>

            <% if (order.orderStatus === "Processing") { %>
              <option value="Processing" selected disabled>Processing (Current Status)</option>
              <option value="Shipped">Move to Shipped</option>
              <option value="Cancelled">Cancel Order</option>
            <% } %>

            <% if (order.orderStatus === "Shipped") { %>
              <option value="Shipped" selected disabled>Shipped (Current Status)</option>
              <option value="Delivered">Mark as Delivered</option>
            <% } %>

          </select>

          <button type="submit" class="update-btn">
            Update Status
          </button>
        </form>

      <% } %>

<% } %>

      
    </div>
    </div>
    
    </div>
    </div>
    
<%- include("../partials/admin-footer") %>

</body>
</html>