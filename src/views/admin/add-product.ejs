<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">
  <title>Add Product</title>

  <!-- CSS -->
  <link rel="stylesheet" href="/css/adminSidebar.css">
  <link rel="stylesheet" href="/css/addProduct.css">
  <link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css"
/>
</head>

<body>

<!-- HEADER -->
<%- include("../partials/admin-header") %>

<div class="page-layout">

  <!-- SIDEBAR -->
  <%- include("../partials/admin-sidebar") %>

  <!-- MAIN CONTENT -->
  <div class="main-content">

    <div class="form-container">

      <h2>Add Product</h2>

      <!-- ERROR -->
       <p
  id="formError"
  class="error-msg"
></p>

<% if(error){ %>

<script>

window.addEventListener(
  "load",
  function(){

    document.getElementById(
      "formError"
    ).innerText =
      "<%= error %>";

  }
);

</script>

<% } %>

      <!-- FORM -->
      <form
        action="/admin/add-product"
        method="POST"
        enctype="multipart/form-data"
         onsubmit="return validateProductForm()"
          novalidate
      >

        <!-- PRODUCT NAME -->
        <div class="form-group">

          <label>
            Product Name
          </label>

          <input
            type="text"
            name="name"
            placeholder="Enter product name"
            required
          >

        </div>

        <!-- DESCRIPTION -->
        <div class="form-group">

          <label>
            Description
          </label>

          <textarea
            name="description"
            placeholder="Enter description"
          ></textarea>

        </div>

        <!-- CATEGORY -->
        <div class="form-group">

          <label>
            Category
          </label>

          <select
            name="category"
            required
          >

            <option value="">
              Select Category
            </option>

            <% categories.forEach(category => { %>

              <option value="<%= category._id %>">
                <%= category.name %>
              </option>

            <% }) %>

          </select>

        </div>

        <!-- PRICE -->
        <div class="form-group">

          <label>
            Price
          </label>

          <input
            type="number"
            name="price"
            placeholder="Enter price"
            required
          >

        </div>

        <!-- STOCK -->
        <div class="form-group">

          <label>
            Stock
          </label>

          <input
            type="number"
            name="stock"
            placeholder="Enter stock"
            required
          >

        </div>

        <!-- IMAGES -->
        <div class="form-group">

          <label>
            Product Images (Minimum 3)
          </label>

          <input
            type="file"
            name="images"
            id="imageInput"
            multiple
            accept="image/*"
            required
          >

        </div>

        <!-- IMAGE PREVIEW -->
        <div
          class="preview-container"
          id="previewContainer"
        ></div>

        <!-- BUTTONS -->
        <div class="form-actions">

          <a
            href="/admin/products"
            class="cancel-btn"
          >
            Cancel
          </a>

          <button
            type="submit"
            class="add-btn"
          >
            Add Product
          </button>

        </div>

      </form>

    </div>

  </div>

</div>


<script>

function validateProductForm(){

  const name = document.querySelector('input[name="name"]').value.trim();

  const description = document.querySelector('textarea[name="description"]').value.trim();

  const category = document.querySelector('select[name="category"]').value;

  const price = document.querySelector('input[name="price"]').value;

  const stock = document.querySelector('input[name="stock"]').value;

  const imageInput = document.querySelector('input[name="images"]');

  const images = imageInput.files;

  const error = document.getElementById("formError");

  error.innerText = "";

  // EMPTY NAME
  if(name === ""){

    error.innerText = "Product name is required";

    return false;

  }

  // NAME LENGTH
  if(name.length < 3){

    error.innerText = "Product name must contain at least 3 characters";

    return false;

  }

  // EMPTY DESCRIPTION
  if(description === ""){

    error.innerText = "Description is required";

    return false;

  }

  // CATEGORY VALIDATION
  if(category === ""){

    error.innerText = "Please select a category";

    return false;

  }

  // EMPTY PRICE
  if(price === ""){

    error.innerText = "Price is required";

    return false;

  }

  // PRICE VALIDATION
  if(price <= 0){

    error.innerText = "Price must be greater than 0";

    return false;

  }

  // EMPTY STOCK
  if(stock === ""){

    error.innerText = "Stock is required";

    return false;

  }

  // STOCK VALIDATION
  if(stock < 0){

    error.innerText = "Stock cannot be negative";

    return false;

  }

  // ADD PRODUCT PAGE
  if(window.location.pathname.includes("add-product")){

    if(images.length < 3){

      error.innerText = "Minimum 3 images required";

      return false;

    }

  }

  // EDIT PRODUCT PAGE
  if(window.location.pathname.includes("edit-product")){

    if(images.length > 0 && images.length < 3){

      error.innerText = "Upload minimum 3 images";

      return false;

    }

  }

  return true;

}

</script>
<!-- CROPPER MODAL -->
<div
  id="cropModal"
  class="crop-modal"
>

  <div class="crop-box">

    <img id="cropImage">

    <div class="crop-actions">

      <button
        type="button"
        id="cropBtn"
        class="add-btn"
      >
        Crop
      </button>

      <button
        type="button"
        onclick="closeCropModal()"
        class="cancel-btn"
      >
        Cancel
      </button>

    </div>

  </div>

</div>

<!-- FOOTER -->
<%- include("../partials/admin-footer") %>
<!-- cropper CDN-->
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>

<script>

window.addEventListener("load", function(){

  const imageInput =
    document.getElementById("imageInput");

  const previewContainer =
    document.getElementById("previewContainer");

  const cropModal =
    document.getElementById("cropModal");

  const cropImage =
    document.getElementById("cropImage");

  const cropBtn =
    document.getElementById("cropBtn");

  let cropper;

  imageInput.addEventListener(
    "change",
    function(e){

      const files = e.target.files;

      // if(files.length < 3){

      //   alert(
      //     "Minimum 3 images required"
      //   );

      //   imageInput.value = "";

      //   return;

      // }

      previewContainer.innerHTML = "";

      const file = files[0];

        const reader =
          new FileReader();

        reader.onload =
          function(event){

            cropModal.style.display =
              "flex";

            cropImage.src =
              event.target.result;

            // DESTROY OLD CROPPER
            if(cropper){

              cropper.destroy();

            }

            cropper =
              new Cropper(
                cropImage,
                {
                  aspectRatio:1,
                  viewMode:1
                }
              );

            cropBtn.onclick =
              function(){

                const canvas =
                  cropper.getCroppedCanvas({
                    width:500,
                    height:500
                  });

                const img =
                  document.createElement("img");

                img.src =
                  canvas.toDataURL();

                img.classList.add(
                  "preview-image"
                );

                previewContainer.appendChild(
                  img
                );

                cropper.destroy();

                cropModal.style.display =
                  "none";

              };

          };

        reader.readAsDataURL(file);

      });


  window.closeCropModal =
    function(){

      cropModal.style.display =
        "none";

      if(cropper){

        cropper.destroy();

      }

    };

});

</script>

</body>
</html>