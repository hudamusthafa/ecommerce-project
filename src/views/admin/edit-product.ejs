<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">
  <title>Edit Product</title>

  <link rel="stylesheet" href="/css/adminSidebar.css">
  <link rel="stylesheet" href="/css/addProduct.css">
   <link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css"
/>
</head>

<body>

  <!-- HEADER -->
  <%- include("../partials/admin-header") %>

  <div class="layout">

    <!-- SIDEBAR -->
    <%- include("../partials/admin-sidebar") %>

    <div class="main-content">

      <div class="form-container">

        <h2>Edit Product</h2>

        <!-- ERROR MESSAGE -->
        <p
          id="formError"
          class="error-msg"
        ></p>

        <% if(error){ %>

          <script>

          window.addEventListener(
            "load",
            function(){

              document.getElementById(
                "formError"
              ).innerText =
                "<%= error %>";

            }
          );

          </script>

        <% } %>

        <!-- FORM -->
        <form
          action="/admin/edit-product/<%= product._id %>?_method=PUT"
          method="POST"
          enctype="multipart/form-data"
          onsubmit="return validateProductForm()"
          novalidate
        >

          <!-- PRODUCT NAME -->
          <div class="form-group">

            <label>
              Product Name
            </label>

            <input
              type="text"
              name="name"
              value="<%= product.name %>"
              required
            >

          </div>

          <!-- DESCRIPTION -->
          <div class="form-group">

            <label>
              Description
            </label>

            <textarea
              name="description"
            ><%= product.description %></textarea>

          </div>

          <!-- CATEGORY -->
          <div class="form-group">

            <label>
              Category
            </label>

            <select
              name="category"
              required
            >

              <% categories.forEach(function(category){ %>

                <option
                  value="<%= category._id %>"

                  <% if(
                    product.category &&
                    product.category._id.toString() ===
                    category._id.toString()
                  ){ %>

                    selected

                  <% } %>
                >

                  <%= category.name %>

                </option>

              <% }) %>

            </select>

          </div>

          <!-- PRICE -->
          <div class="form-group">

            <label>
              Price
            </label>

            <input
              type="number"
              name="price"
              value="<%= product.price %>"
              required
            >

          </div>

          <!-- STOCK -->
          <div class="form-group">

            <label>
              Stock
            </label>

            <input
              type="number"
              name="stock"
              value="<%= product.stock %>"
              required
            >

          </div>

          <!-- CURRENT IMAGES -->
          <div class="form-group">

            <label>
              Current Images
            </label>

            <div class="preview-container">

              <% product.images.forEach(function(image){ %>

                <img
                  src="/images/<%= image %>"
                  class="preview-image"
                >

              <% }) %>

            </div>

          </div>

          <!-- NEW IMAGES -->
          <div class="form-group">

            <label>
              Replace Images
            </label>

            <input
              type="file"
              name="images"
              multiple
              accept="image/*"
            >

          </div>

          <!-- BUTTONS -->
          <div class="form-actions">

            <a
              href="/admin/products"
              class="cancel-btn"
            >
              Cancel
            </a>

            <button
              type="submit"
              class="add-btn"
            >
              Update Product
            </button>

          </div>

        </form>

      </div>

    </div>

  </div>

  <!-- VALIDATION SCRIPT -->
  <script>

  function validateProductForm(){

    const name = document.querySelector('input[name="name"]').value.trim();
    const description = document.querySelector('textarea[name="description"]').value.trim();
    const category = document.querySelector('select[name="category"]').value;
    const price = document.querySelector('input[name="price"]').value;
    const stock = document.querySelector('input[name="stock"]').value;
    const imageInput = document.querySelector('input[name="images"]');
    const images = imageInput.files;
    const error = document.getElementById("formError");
    error.innerText = "";

    // EMPTY NAME
    if(name === ""){

      error.innerText = "Product name is required";

      return false;

    }

    // NAME LENGTH
    if(name.length < 3){

      error.innerText = "Product name must contain at least 3 characters";

      return false;

    }

    // EMPTY DESCRIPTION
    if(description === ""){

      error.innerText = "Description is required";

      return false;

    }

    // CATEGORY VALIDATION
    if(category === ""){

      error.innerText = "Please select a category";

      return false;

    }

    // EMPTY PRICE
    if(price === ""){

      error.innerText = "Price is required";

      return false;

    }

    // PRICE VALIDATION
    if(price <= 0){

      error.innerText = "Price must be greater than 0";

      return false;

    }

    // EMPTY STOCK
    if(stock === ""){

      error.innerText = "Stock is required";

      return false;

    }

    // STOCK VALIDATION
    if(stock < 0){

      error.innerText = "Stock cannot be negative";

      return false;

    }

    // EDIT IMAGE VALIDATION
    if(images.length > 0 && images.length < 3){

      error.innerText = "Upload minimum 3 images";

      return false;

    }

    return true;

  }

  </script>

  <!-- CROPPER MODAL -->
<div
  id="cropModal"
  class="crop-modal"
>

  <div class="crop-box">

    <img id="cropImage">

    <div class="crop-actions">

      <button
        type="button"
        id="cropBtn"
        class="add-btn"
      >
        Crop
      </button>

      <button
        type="button"
        onclick="closeCropModal()"
        class="cancel-btn"
      >
        Cancel
      </button>

    </div>

  </div>

</div>

<script>

const imageInput = document.querySelector('input[name="images"]');
const previewContainer = document.querySelector(".preview-container");
const cropModal = document.getElementById("cropModal");
const cropImage = document.getElementById("cropImage");
const cropBtn = document.getElementById("cropBtn");
let cropper;

imageInput.addEventListener("change", function(e){
  const files = e.target.files;

  // EDIT PAGE VALIDATION
  if(files.length > 0 && files.length < 3){
    alert("Minimum 3 images required");
    imageInput.value = "";
    return;
  }

  // REMOVE OLD PREVIEW
  previewContainer.innerHTML = "";

  Array.from(files).forEach(function(file){
    const reader = new FileReader();
    reader.onload = function(event){
      cropModal.style.display = "flex";
      cropImage.src = event.target.result;

      // DESTROY OLD CROPPER
      if(cropper){
        cropper.destroy();
      }

      cropper = new Cropper(cropImage, {

        aspectRatio: 1,
        viewMode: 1

      });

      cropBtn.onclick = function(){
        const canvas = cropper.getCroppedCanvas({
          width: 500,
          height: 500
        });

        const img = document.createElement("img");
        img.src = canvas.toDataURL();
        img.classList.add("preview-image");
        previewContainer.appendChild(img);
        cropper.destroy();
        cropModal.style.display = "none";
      };
    };
    reader.readAsDataURL(file);
  });
});

function closeCropModal(){
  cropModal.style.display = "none";
  if(cropper){
    cropper.destroy();
  }
}

</script>

  <!-- FOOTER -->
  <%- include("../partials/admin-footer") %>

 <!--cropper cdn--> 
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
</body>
</html>