<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">
  <title>Edit Product</title>

  <!-- CSS -->
  <link rel="stylesheet" href="/css/adminSidebar.css">
  <link rel="stylesheet" href="/css/addProduct.css">

  <!-- CROPPER CSS -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css"
  >

</head>

<body>

<!-- HEADER -->
<%- include("../partials/admin-header") %>

<div class="layout">

  <!-- SIDEBAR -->
  <%- include("../partials/admin-sidebar") %>

  <div class="main-content">

    <div class="form-container">

      <h2>Edit Product</h2>

      <!-- ERROR -->
      <p
        id="formError"
        class="error-msg"
      ></p>

      <% if(error){ %>

      <script>

      window.addEventListener("load",function(){

        document.getElementById(
          "formError"
        ).innerText="<%= error %>";

      });

      </script>

      <% } %>

      <!-- FORM -->
      <form
        action="/admin/edit-product/<%= product._id %>?_method=PUT"
        method="POST"
        enctype="multipart/form-data"
        onsubmit="return validateProductForm()"
        novalidate
      >

        <!-- PRODUCT NAME -->
        <div class="form-group">

          <label>
            Product Name
          </label>

          <input
            type="text"
            name="name"
            value="<%= product.name %>"
          >

        </div>

        <!-- DESCRIPTION -->
        <div class="form-group">

          <label>
            Description
          </label>

          <textarea
            name="description"
          ><%= product.description %></textarea>

        </div>

        <!-- CATEGORY -->
        <div class="form-group">

          <label>
            Category
          </label>

          <select name="category">

            <% categories.forEach(function(category){ %>

            <option
              value="<%= category._id %>"

              <% if(
                product.category &&
                product.category._id.toString()===
                category._id.toString()
              ){ %>

                selected

              <% } %>
            >

              <%= category.name %>

            </option>

            <% }) %>

          </select>

        </div>

        <!-- PRICE -->
        <div class="form-group">

          <label>
            Price
          </label>

          <input
            type="number"
            name="price"
            value="<%= product.price %>"
          >

        </div>

        <!-- STOCK -->
        <div class="form-group">

          <label>
            Stock
          </label>

          <input
            type="number"
            name="stock"
            value="<%= product.stock %>"
          >

        </div>

        <!-- CURRENT IMAGES -->
        <div class="form-group">

          <label>
            Current Images
          </label>

          <div
            class="preview-container"
            id="previewContainer"
          >

            <% product.images.forEach(function(image,index){ %>

            <div class="preview-wrapper existing-image">

              <img
                src="/images/<%= image %>"
                class="preview-image"
              >

              <button
                type="button"
                class="remove-image-btn existing-remove-btn"
                data-index="<%= index %>"
              >
                ×
              </button>

            </div>

            <% }) %>

          </div>

        </div>

        <!-- REMOVED IMAGES -->
        <input
          type="hidden"
          name="removedImages"
          id="removedImages"
        >

        <!-- NEW IMAGES -->
        <div class="form-group">

          <label>
            Replace Images
            (Upload One By One)
          </label>

          <input
            type="file"
            id="imageInput"
            accept="image/*"
          >

          <!-- FINAL FILES -->
          <input
            type="file"
            id="finalImages"
            name="images"
            multiple
            hidden
          >

        </div>

        <!-- IMAGE COUNT -->
        <p id="imageCount">
          0 images selected
        </p>

        <!-- BUTTONS -->
        <div class="form-actions">

          <a
            href="/admin/products"
            class="cancel-btn"
          >
            Cancel
          </a>

          <button
            type="submit"
            class="add-btn"
          >
            Update Product
          </button>

        </div>

      </form>

    </div>

  </div>

</div>

<!-- CROPPER MODAL -->
<div
  id="cropModal"
  class="crop-modal"
>

  <div class="crop-box">

    <img id="cropImage">

    <div class="crop-actions">

      <button
        type="button"
        id="cropBtn"
        class="add-btn"
      >
        Crop
      </button>

      <button
        type="button"
        onclick="closeCropModal()"
        class="cancel-btn"
      >
        Cancel
      </button>

    </div>

  </div>

</div>

<!-- FOOTER -->
<%- include("../partials/admin-footer") %>

<!-- CROPPER CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>

<!-- VALIDATION -->
<script>

function validateProductForm(){

  const name=document.querySelector(
    'input[name="name"]'
  ).value.trim();

  const description=document.querySelector(
    'textarea[name="description"]'
  ).value.trim();

  const category=document.querySelector(
    'select[name="category"]'
  ).value;

  const price=document.querySelector(
    'input[name="price"]'
  ).value;

  const stock=document.querySelector(
    'input[name="stock"]'
  ).value;

  const images=document.getElementById(
    "finalImages"
  ).files;

  const error=document.getElementById(
    "formError"
  );

  error.innerText="";

  // NAME
  if(name===""){

    error.innerText=
      "Product name is required";

    return false;

  }

  if(name.length<3){

    error.innerText=
      "Product name must contain at least 3 characters";

    return false;

  }

  // DESCRIPTION
  if(description===""){

    error.innerText=
      "Description is required";

    return false;

  }

  // CATEGORY
  if(category===""){

    error.innerText=
      "Please select a category";

    return false;

  }

  // PRICE
  if(price===""){

    error.innerText=
      "Price is required";

    return false;

  }

  if(price<=0){

    error.innerText=
      "Price must be greater than 0";

    return false;

  }

  // STOCK
  if(stock===""){

    error.innerText=
      "Stock is required";

    return false;

  }

  if(stock<0){

    error.innerText=
      "Stock cannot be negative";

    return false;

  }

  // IMAGE VALIDATION

const existingImages=
  document.querySelectorAll(
    ".existing-image"
  ).length;

const uploadedImages=
  uploadedFiles.length;

const totalImages=
  existingImages+
  uploadedImages;

if(totalImages<3){

  error.innerText=
    "Minimum 3 images required";

  return false;

}
  return true;

}

</script>

<!-- CROPPER SCRIPT -->
<script>

window.addEventListener("load",function(){

  const imageInput=document.getElementById("imageInput");
  const finalImages=document.getElementById("finalImages");
  const previewContainer=document.getElementById("previewContainer");
  const cropModal=document.getElementById("cropModal");
  const cropImage=document.getElementById("cropImage");
  const cropBtn=document.getElementById("cropBtn");

  let cropper;
  let uploadedFiles=[];
  let removedImages=[];

  // REMOVE EXISTING IMAGE
  document.querySelectorAll(
    ".existing-remove-btn"
  ).forEach(function(btn){

    btn.addEventListener(
      "click",
      function(){

        const wrapper=this.closest(
          ".preview-wrapper"
        );

        const imageSrc=wrapper
          .querySelector("img")
          .src;

        const imageName=imageSrc
          .split("/")
          .pop();

        removedImages.push(
          imageName
        );

        document.getElementById(
          "removedImages"
        ).value=JSON.stringify(
          removedImages
        );

        wrapper.remove();

      }
    );

  });

  // ADD NEW IMAGE
  imageInput.addEventListener(
    "change",
    function(e){

      if(uploadedFiles.length>=5){

        alert(
          "Maximum 5 images allowed"
        );

        imageInput.value="";

        return;

      }

      const file=e.target.files[0];

      if(!file){

        return;

      }

      const reader=new FileReader();

      reader.onload=function(event){

        cropModal.style.display="flex";

        cropImage.src=
          event.target.result;

        if(cropper){

          cropper.destroy();

        }

        cropper=new Cropper(
          cropImage,
          {
            aspectRatio:1,
            viewMode:1
          }
        );

        cropBtn.onclick=function(){

          const canvas=
            cropper.getCroppedCanvas({
              width:500,
              height:500
            });

          canvas.toBlob(
            function(blob){

              const croppedFile=
                new File(
                  [blob],
                  file.name,
                  {
                    type:file.type
                  }
                );

              uploadedFiles.push(
                croppedFile
              );

              const dataTransfer=
                new DataTransfer();

              uploadedFiles.forEach(
                function(file){

                  dataTransfer.items.add(
                    file
                  );

                }
              );

              finalImages.files=
                dataTransfer.files;

              // PREVIEW
              const wrapper=
                document.createElement(
                  "div"
                );

              wrapper.classList.add(
                "preview-wrapper"
              );

              const img=
                document.createElement(
                  "img"
                );

              img.src=
                canvas.toDataURL();

              img.classList.add(
                "preview-image"
              );

              const removeBtn=
                document.createElement(
                  "button"
                );

              removeBtn.innerText="×";

              removeBtn.classList.add(
                "remove-image-btn"
              );

              removeBtn.onclick=
                function(){

                  const index=
                    uploadedFiles.indexOf(
                      croppedFile
                    );

                  if(index>-1){

                    uploadedFiles.splice(
                      index,
                      1
                    );

                  }

                  const updatedTransfer=
                    new DataTransfer();

                  uploadedFiles.forEach(
                    function(file){

                      updatedTransfer.items.add(
                        file
                      );

                    }
                  );

                  finalImages.files=
                    updatedTransfer.files;

                  wrapper.remove();

                  document.getElementById(
                    "imageCount"
                  ).innerText=
                    uploadedFiles.length+
                    " images selected";

                };

              wrapper.appendChild(img);

              wrapper.appendChild(
                removeBtn
              );

              previewContainer.appendChild(
                wrapper
              );

              document.getElementById(
                "imageCount"
              ).innerText=
                uploadedFiles.length+
                " images selected";

              cropper.destroy();

              cropModal.style.display=
                "none";

              imageInput.value="";

            },
            file.type
          );

        };

      };

      reader.readAsDataURL(file);

    }
  );

  window.closeCropModal=function(){

    cropModal.style.display=
      "none";

    if(cropper){

      cropper.destroy();

    }

  };

});

</script>

</body>
</html>