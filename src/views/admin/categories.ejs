<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Category Management</title>
<link rel="stylesheet" href="/css/adminSidebar.css">
  <link rel="stylesheet" href="/css/category.css">

  <link rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

</head>

<body>

  
<%- include('../partials/admin-header') %>

<div class="layout">

  <!-- SIDEBAR -->
<%- include("../partials/admin-sidebar") %>

  <!-- MAIN CONTENT -->
  <div class="main-content">

    <div class="category-page">

      

      <!-- TOP -->
      <div class="top-section">

        <h1>Categories</h1>

        <form action="/admin/categories" method="GET" class="search-box">




          
          <div class="search-input">

            <i class="fa-solid fa-magnifying-glass"></i>

            <input
              type="text"
              name="search"
              placeholder="Search Bar"
              value="<%= search || '' %>"
            >

            <% if(search){ %>

              <a href="/admin/categories" class="clear-search">
                <i class="fa-solid fa-xmark"></i>
              </a>

            <% } else { %>

              <i class="fa-solid fa-xmark dummy-x"></i>

            <% } %>

          </div>

        </form>

      </div>

      <!-- SUMMARY -->
      <div class="summary-card">

        <div class="summary-left">

          <div class="summary-item">
            Total Categories:
            <strong><%= total %></strong>
          </div>

          <div class="divider"></div>

          <div class="summary-item">
            Listed:
            <strong><%= categories.filter(c => c.isListed).length %></strong>
          </div>

          <div class="divider"></div>

          <div class="summary-item">
            Unlisted:
            <strong><%= categories.filter(c => !c.isListed).length %></strong>
          </div>

        </div>

        <a href="/admin/add-category" class="add-btn">

          <i class="fa-solid fa-plus"></i>

          Add Category

        </a>

      </div>

      <!-- TABLE -->
      <div class="table-card">

        <table>

          <thead>

            <tr>

              <th>Category Name</th>
             <th>Category Offer</th>
              <th class="highlight-column">Added ↓</th>
              <th>Status</th>
              <th>Action</th>

            </tr>

          </thead>

          <tbody>

          <% if(categories.length > 0){ %>

            <% categories.forEach((category)=>{ %>

              <tr>

             

              <!-- CATEGORY -->
              <td>

                <div class="category-info">

                  <!-- <div class="category-image">
                    <i class="fa-regular fa-image"></i>
                  </div> -->

                  <span><%= category.name %></span>

                </div>

              </td>


              <!-- offer -->

              <td>
                  <% if(category.categoryOffer > 0){ %>
                      <span class="offer-badge">
                          <%= category.categoryOffer %>% OFF
                      </span>
                  <% } else { %>
                      <span class="no-offer">No Offer</span>
                  <% } %>
              </td>

              <!-- DATE -->
              <td class="highlight-column">

                <%= new Date(category.createdAt).toLocaleDateString("en-GB", {
                  day: "2-digit",
                  month: "short",
                  year: "numeric"
                }) %>

              </td>

              <!-- STATUS -->
              <td>

               <% if(category.isListed){ %>
                  <span class="status listed">Listed</span>
                <% } else { %>
                  <span class="status archived">Unlisted</span>
                <% } %>

              </td>

              <!-- ACTION -->
              <td>

                <div class="actions">

                  <a
                    href="/admin/edit-category/<%= category._id %>"
                    class="icon-btn"
                  >
                    <i class="fa-solid fa-pen"></i>
                  </a>

                 <button
                  type="button"
                  class="icon-btn"
                 onclick="openViewModal(
                    '<%= category.name %>',
                    `<%= category.description || "No description" %>`,
                    '<%= category.categoryOffer %>',
                    '<%= new Date(category.createdAt).toLocaleDateString("en-GB", {
                      day: "2-digit",
                      month: "short",
                      year: "numeric"
                    }) %>',
                    '<%= category.isListed ? "Listed" : "Unlisted" %>'
                  )"
                >
                  <i class="fa-regular fa-eye"></i>
                </button>


                  <form
                    action="/admin/delete-category/<%= category._id %>?_method=DELETE"
                    method="POST"
                    onsubmit="return confirmDelete()"
                  >

                    <button
                      type="button"
                      class="icon-btn"
                      onclick="openDeleteModal('<%= category._id %>', <%= category.isListed  %>)"
                    >
                <% if(category.isListed){ %>
                      <i class="fa-solid fa-trash" style="color:#dc3545"></i>
                    <% } else { %>
                      <i class="fa-solid fa-rotate-left" style="color:#28a745"></i>
                    <% } %>
                    
                  </button>
                  </form>

                </div>

              </td>

            </tr>
                        <% }) %>

                      <% } else { %>

                        <tr>

                          <td colspan="6" class="empty-msg">
                            No categories found
                          </td>

                        </tr>

          <% } %>

          </tbody>

        </table>

        
     <!-- PAGINATION -->

<div class="pagination">

  <% if(currentPage > 1) { %>

    <a
      href="/admin/categories?page=<%= currentPage - 1 %>&search=<%= search %>"
    >
      Prev
    </a>

  <% } %>

  <% for(let i = 1; i <= totalPages; i++) { %>

    <a
      href="/admin/categories?page=<%= i %>&search=<%= search %>"
      class="<%= currentPage === i ? 'active-page' : '' %>"
    >
      <%= i %>
    </a>

  <% } %>

  <% if(currentPage < totalPages) { %>

    <a
      href="/admin/categories?page=<%= currentPage + 1 %>&search=<%= search %>"
    >
      Next
    </a>

  <% } %>

</div>
      </div>

    </div>

  </div>

</div>
<!-- DELETE FORM -->
<form id="deleteForm" method="POST"></form>

<!-- DELETE MODAL -->
<div id="deleteModal" class="modal">

  <div class="modal-box">

  <p id="modalText">Archive this category?</p>

    <button
      class="confirm-btn"
      onclick="confirmDelete()"
    >
      Yes
    </button>

    <button
      class="cancel-btn"
      onclick="closeDeleteModal()"
    >
      Cancel
    </button>

  </div>

</div>

<!-- VIEW MODAL -->

<div id="viewModal" class="modal">

  <div class="modal-box view-box">

    <h3 id="viewTitle"></h3>

    <p>
    <strong>Category Offer:</strong>
    <span id="viewOffer"></span>
</p>

    <p>
      <strong>Description:</strong>
    </p>


    <p id="viewDescription"></p>

    <p>
      <strong>Created:</strong>
      <span id="viewDate"></span>
    </p>

    <p>
      <strong>Status:</strong>
      <span id="viewStatus"></span>
    </p>

    <button
      class="cancel-btn"
      onclick="closeViewModal()"
    >
      Close
    </button>

  </div>

</div>

<script>

  let deleteId = "";

  function openDeleteModal(id, isListed) {
  deleteId = id;

  
  document.getElementById("modalText").innerText = isListed
  ? "Unlist this category?"
  : "List this category back?";

  document.getElementById("deleteModal").style.display = "flex";
}

  function closeDeleteModal() {

    document.getElementById(
      "deleteModal"
    ).style.display = "none";

  }

  function confirmDelete() {

    const form =
      document.getElementById("deleteForm");

    form.action =
      "/admin/delete-category/" +
      deleteId +
      "?_method=DELETE";

    form.submit();

  }

</script>
<script>

  function openViewModal(
    name,
    description,
    offer,
    date,
    status
  ) {

    document.getElementById(
      "viewTitle"
    ).innerText = name;

    document.getElementById(
      "viewDescription"
    ).innerText = description;

    document.getElementById(
      "viewDate"
    ).innerText = date;

    document.getElementById(
      "viewStatus"
    ).innerText = status;

    document.getElementById(
      "viewModal"
    ).style.display = "flex";

    document.getElementById("viewOffer").innerText =
    offer > 0 ? offer + "% OFF" : "No Offer";
  }

  function closeViewModal() {

    document.getElementById(
      "viewModal"
    ).style.display = "none";

  }

</script>
<%- include('../partials/admin-footer') %>
</body>
</html>