<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <title>Add Coupon</title>

    <link rel="stylesheet" href="/css/adminSidebar.css">
    <link rel="stylesheet" href="/css/admin-addcoupon.css">
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      />

</head>

<body>

<%- include("../partials/admin-header") %>

<div class="layout">

    <%- include("../partials/admin-sidebar") %>

    <div class="main-content">

        <div class="category-page">

            <!-- TOP -->

            <div class="top-section">

                <h1>Add Coupon</h1>

                <div class="page-actions">

                  <a href="/admin/coupons" class="back-btn">

                      <i class="fa-solid fa-arrow-left"></i>

                      <span>Back to Coupons</span>

                  </a>

              </div>
            </div>

          <% if (error) { %>

          <div class="coupon-error">

              <i class="fa-solid fa-circle-exclamation"></i>

              <span><%= error %></span>

          </div>

          <% } %>

            <div class="table-card">

                <form
                    action="/admin/add-coupon"
                    method="POST"
                    class="coupon-form"
                >

                    <div class="form-grid">

                        <div class="form-group">

                            <label>Coupon Code</label>

                            <input
                                type="text"
                                name="code"
        
                                value="<%= formData.code || '' %>"
                                
                            >

                        </div>

                        <div class="form-group">

                            <label>Description</label>

                            <input
                                type="text"
                                name="description"
                                value="<%= formData.description || '' %>"
                                
                            >

                        </div>

                        <div class="form-group">

                            <label>Discount Type</label>

                            <select name="discountType">

                                 <option
                                    value="percentage"
                                    <%= formData.discountType === "percentage" ? "selected" : "" %>>
                                    Percentage
                                </option>

                                <option
                                    value="flat"
                                    <%= formData.discountType === "flat" ? "selected" : "" %>>
                                    Flat Amount
                                </option>

                            </select>

                        </div>

                        <div class="form-group">

                            <label>Discount Value</label>

                            <input
                                type="number"
                                name="discountValue"
                                value="<%= formData.discountValue || '' %>"
                            >

                        </div>

                        <div class="form-group">

                            <label>Maximum Discount</label>

                            <input
                              type="number"
                              name="maxDiscount"
                              value="<%= formData.maxDiscount || '' %>"
                          >

                        </div>

                        <div class="form-group">

                            <label>Minimum Purchase</label>

                            <input
                              type="number"
                              name="minPurchase"
                              value="<%= formData.minPurchase || '' %>"
                          >

                        </div>

                        <div class="form-group">

                            <label>Usage Limit</label>

                            <input
                                type="number"
                                name="usageLimit"
                                value="<%= formData.usageLimit || 1 %>"
                            >

                        </div>

                        <div class="form-group">

                            <label>Per User Limit</label>

                            <input
                                type="number"
                                name="perUserLimit"
                                value="<%= formData.perUserLimit || 1 %>"
                            >

                        </div>

                        <div class="form-group">

                            <label>Start Date</label>

                            <input
                                type="date"
                                name="startDate"
                              value="<%= formData.startDate || '' %>"
                            >

                        </div>

                        <div class="form-group">

                            <label>Expiry Date</label>

                            <input
                                type="date"
                                name="expiryDate"
                                 value="<%= formData.expiryDate || '' %>"
                            >

                        </div>

                    </div>

                    <div class="form-actions">

                        <button
                            type="submit"
                            class="save-btn"
                        >
                            Save Coupon
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

<%- include("../partials/admin-footer") %>

</body>

</html>