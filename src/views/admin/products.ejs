<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">
  <title>Product Management</title>

  <link rel="stylesheet" href="/css/adminSidebar.css">
  <link rel="stylesheet" href="/css/category.css">

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  >

</head>

<body>

<!-- HEADER -->
<%- include('../partials/admin-header') %>

<div class="layout">

  <%- include('../partials/admin-sidebar') %>

  <!-- MAIN CONTENT -->
  <div class="main-content">

    <div class="category-page">

      <!-- TOP -->
      <div class="top-section">

        <h1>Products</h1>

      
        <!-- SEARCH + FILTER -->
<form action="/admin/products" method="GET" class="search-box filter-form">

  <!-- SEARCH -->
  <div class="search-input">
    <i class="fa-solid fa-magnifying-glass"></i>

    <input
      type="text"
      name="search"
      placeholder="Search Product"
      value="<%= search || '' %>"
    >
  </div>

<!-- CLEAR BUTTON -->
<a
  href="/admin/products"
  class="clear-btn"
>
  Clear
</a>

  <!-- CATEGORY FILTER -->
  <select name="category" onchange="this.form.submit()">

    <option value="">All Categories</option>

    <% categories.forEach(function(cat){ %>

      <option
        value="<%= cat._id %>"
        <%= category==cat._id.toString() ? "selected" : "" %>
      >
        <%= cat.name %>
      </option>

    <% }) %>

  </select>

  <!-- STOCK FILTER -->
  <select name="stock"  onchange="this.form.submit()">

    <option value="">All Stock</option>

    <option
      value="inStock"
      <%= stock==="inStock" ? "selected" : "" %>
    >
      In Stock
    </option>


     <option
      value="lowStock"
      <%= stock==="lowStock" ? "selected" : "" %>
    >
      Low Stock
    </option>

    
    <option
      value="outOfStock"
      <%= stock==="outOfStock" ? "selected" : "" %>
    >
      Out Of Stock
    </option>

  </select>

  <!-- STATUS FILTER -->
  <select name="status"  onchange="this.form.submit()">

    <option value="">All Status</option>

    <option
      value="listed"
      <%= status==="listed" ? "selected" : "" %>
    >
      Listed
    </option>

    <option
      value="unlisted"
      <%= status==="unlisted" ? "selected" : "" %>
    >
      Unlisted
    </option>

  </select>

 
<!-- OFFER FILTER -->

<select
  name="offer"
  onchange="this.form.submit()"
>

  <option value="">
    Offers
  </option>

  <option
    value="withOffer"
    <%= offer === "withOffer" ? "selected" : "" %>
  >
    With Offer
  </option>

  <option
    value="withoutOffer"
    <%= offer === "withoutOffer" ? "selected" : "" %>
  >
    Without Offer
  </option>

</select>
  

</form>

      </div>

      <!-- SUMMARY -->
      <div class="summary-card">

        <div class="summary-left">

          <div class="summary-item">

            Total Products:
            <strong><%= total %></strong>

          </div>

        </div>

<!-- Add Product Button -->

        <a
          href="/admin/add-product"
          class="add-btn"
        >

          <i class="fa-solid fa-plus"></i>

          Add Product

        </a>

      </div>

      <!-- TABLE -->
      <div class="table-card">

        <table>

          <thead>

            <tr>

              <th>Product</th>
              <th>Category</th>
              <th>Price</th>
              <th>Offer</th>
              <th>Stock</th>
              <th>Date</th>
              <th>Status</th>
              <th>Action</th>

            </tr>

          </thead>

          <tbody>

            <% if(products.length > 0){ %>

              <% products.forEach(function(product){ %>

                <tr>

                  <!-- PRODUCT -->
                   
                  
                    <td>

                      <div class="product-info">

                        <% if(product.images.length > 0){ %>

                          <img
                            src="/images/<%= product.images[0] %>"
                            class="product-image"
                          >

                        <% } else { %>

                          <div class="category-image">

                            <i class="fa-regular fa-image"></i>

                          </div>

                        <% } %>

                        <span>
                          <%= product.name %>
                        </span>

                      </div>

                    </td>

                    <!-- CATEGORY -->
                    <td>

                      <%= product.category
                          ? product.category.name
                          : "No Category" %>

                    </td>


                  <!-- PRICE -->
                  <td>

                      ₹<%= product.price %>

                  </td>

                  <td>

                      <% if(product.productOffer > 0){ %>

                          <span class="offer-badge">

                              <%= product.productOffer %>% OFF

                          </span>

                      <% } else { %>

                          <span class="no-offer">

                              --

                          </span>

                      <% } %>

                  </td>

                 <!-- STOCK -->
                    <td>
                        <% if(product.stock === 0){ %>
                          <span class="out-stock">Out Of Stock (0)</span>
                        <% } else if(product.stock <= 5){ %>
                          <span class="low-stock">Low Stock (<%= product.stock %>)</span>
                        <% } else { %>
                          <span class="in-stock">In Stock (<%= product.stock %>)</span>
                        <% } %>
                    </td>

                    
                  <!-- DATE -->
                  <td>

                    <%= new Date(product.createdAt)
                    .toLocaleDateString("en-GB") %>

                  </td>

                  <!-- STATUS -->
                  <td>

                   <% if(product.isListed){ %>

                    <span class="status listed">
                      Listed
                    </span>

                  <% } else { %>

                    <span class="status archived">
                      Unlisted
                    </span>

                  <% } %>
                  </td>

                  <!-- ACTION -->
                  <td>

                    <div class="actions">

                      <!-- EDIT -->
                      <a
                        href="/admin/edit-product/<%= product._id %>?page=<%= currentPage %>"
                        class="icon-btn"
                      >
                        <i class="fa-solid fa-pen"></i>
                      </a>

                     <!-- VIEW -->
                              <button
                                  type="button"
                                  class="icon-btn"
                                  onclick='openViewModal(
                                    "<%= product.name %>",
                                    "<%= product.category ? product.category.name : "No Category" %>",
                                    "<%= product.variant || "N/A" %>",
                                    "<%= product.price %>",
                                    "<%= product.stock %>",
                                    "<%= product.description %>",
                                    <%- JSON.stringify(product.images) %>
                                  )'
                                >
                                  <i class="fa-regular fa-eye"></i>
                                </button>
                                                      <!-- DELETE -->
                    
                      <button
                        type="button"
                        class="icon-btn delete-btn"
                        onclick="openDeleteModal('<%= product._id %>', <%= product.isListed %>)"
                      >
                        <% if(product.isListed){ %>
                          <i class="fa-solid fa-trash" style="color:#dc3545"></i>
                        <% } else { %>
                          <i class="fa-solid fa-rotate-left" style="color:#28a745"></i>
                        <% } %>
                      </button>
                    </div>

                  </td>

                </tr>

              <% }) %>

            <% } else { %>

              <tr>

                <td colspan="8" class="empty-msg">

                  No products found

                </td>

              </tr>

            <% } %>

          </tbody>

        </table>

        <!-- PAGINATION -->
<div class="pagination">

  <% if(currentPage>1){ %>

    <a
      href="/admin/products?page=<%= currentPage-1 %>&search=<%= search %>&category=<%= category %>&stock=<%= stock %>&status=<%= status %>&offer=<%= offer %>"
    >
      Prev
    </a>

  <% } %>

  <% for(let i=1;i<=totalPages;i++){ %>

    <a
      href="/admin/products?page=<%= i %>&search=<%= search %>&category=<%= category %>&stock=<%= stock %>&status=<%= status %>&offer=<%= offer %>"
      class="<%= currentPage===i ? 'active-page' : '' %>"
    >
      <%= i %>
    </a>

  <% } %>

  <% if(currentPage<totalPages){ %>

    <a
      href="/admin/products?page=<%= currentPage+1 %>&search=<%= search %>&category=<%= category %>&stock=<%= stock %>&status=<%= status %>&offer=<%= offer %>"
    >
      Next
    </a>

  <% } %>

</div>

<!-- DELETE FORM -->
<form id="deleteForm" method="POST"></form>

<!-- DELETE MODAL -->
<div id="deleteModal" class="modal">

  <div class="modal-box">

    <p id="modalText"></p>

    <button
      class="confirm-btn"
      onclick="confirmDelete()"
    >
      Yes
    </button>

    <button
      class="cancel-btn"
      onclick="closeDeleteModal()"
    >
      Cancel
    </button>

  </div>

</div>

<!-- VIEW MODAL -->
<div id="viewModal" class="modal">

  <div class="modal-box">

    <h3 id="viewTitle"></h3>

    <p>
      <strong>Category:</strong>
      <span id="viewCategory"></span>
    </p>

    <p>
  <strong>Variant:</strong>
  <span id="viewVariant"></span>
</p>

    <p>
      <strong>Price:</strong>
      ₹ <span id="viewPrice"></span>
    </p>

    <p>
      <strong>Stock:</strong>
      <span id="viewStock"></span>
    </p>

    <p>
      <strong>Description:</strong>
    </p>

    <p id="viewDescription"></p>

    <!-- PRODUCT IMAGES -->
    <div
      id="viewImages"
      class="view-images"
    ></div>

    <button
      class="cancel-btn"
      onclick="closeViewModal()"
    >
      Close
    </button>

  </div>

</div>


<!-- IMAGE ZOOM MODAL -->
<div id="imageZoomModal" class="image-zoom-modal">

  <span
    class="close-zoom"
    onclick="closeImageZoom()"
  >
    &times;
  </span>

  <img
    id="zoomedImage"
    class="zoomed-image"
  >

</div>

<script>

let deleteId = "";

function openDeleteModal(id,isListed){

  deleteId = id;

  document.getElementById("modalText").innerText =
    isListed
      ? "Unlist this product?"
      : "List this product?";

  document.getElementById("deleteModal").style.display="flex";
}

function closeDeleteModal(){
  document.getElementById("deleteModal" ).style.display = "none";
}

function confirmDelete(){

  const form = document.getElementById("deleteForm");

  form.action = "/admin/delete-product/" + deleteId + "?page=<%= currentPage %>&_method=DELETE";

  form.submit();

}

// VIEW MODAL
function openViewModal(
  name,
  category,
  variant,
  price,
  stock,
  description,
  images
){

  document.getElementById("viewTitle").innerText = name;
  document.getElementById("viewCategory").innerText = category;
  document.getElementById("viewVariant").innerText = variant;
  document.getElementById( "viewPrice").innerText = price;
  document.getElementById("viewStock").innerText = stock;
  document.getElementById("viewDescription").innerText = description;

  // SHOW IMAGES
  const imageContainer = document.getElementById("viewImages");
  imageContainer.innerHTML = "";

 images.forEach(function(image){
  imageContainer.innerHTML += `
    <img
      src="/images/${image}"
      class="view-product-image"
      onclick="openImageZoom('/images/${image}')"
    >
  `;
});

  document.getElementById(
    "viewModal"
  ).style.display = "flex";

}

function closeViewModal(){
      document.getElementById(
        "viewModal"
      ).style.display = "none";

}

// IMAGE ZOOM
function openImageZoom(imageSrc){

      document.getElementById(
        "imageZoomModal"
      ).style.display = "flex";

      document.getElementById(
        "zoomedImage"
      ).src = imageSrc;

}

function closeImageZoom(){
      document.getElementById(
        "imageZoomModal"
      ).style.display = "none";

}

</script>

<!-- FOOTER -->
<%- include('../partials/admin-footer') %>

</body>
</html>