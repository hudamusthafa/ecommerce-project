<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit User</title>
  <link rel="stylesheet" href="/css/users.css">
</head>

<body>

<div class="dashboard">

  <!-- SIDEBAR -->
  <div class="sidebar">
    <h3>MENU</h3>
    <ul>
      <li><a href="/admin/dashboard">Dashboard</a></li>
      <li>Products</li>
      <li>Category</li>
      <li>Orders</li>
      <li>Coupon</li>
      <li>Transaction</li>
    </ul>

    <ul class="section">
      <li class="section-title active-section">User Management</li>
      <li><a href="/admin/users">Customers</a></li>
    </ul>

    <ul class="section">
      <li class="section-title">Others</li>
      <li>Settings</li>
      <li>Help</li>
      <li>Logout</li>
    </ul>
  </div>

  <!-- MAIN -->
  <div class="main">

    <div class="form-container">

      <h2>Edit User</h2>

      <% if (error) { %>
        <p class="error-msg"><%= error %></p>
      <% } %>

      <% if (success) { %>
        <p class="success-msg"><%= success %></p>
      <% } %>

      <!-- FORM -->
      <form action="/admin/edit-user/<%= user._id %>?_method=PUT"
            method="POST"
            onsubmit="return validateEditUser()"
            novalidate>

        <!-- NAME -->
        <div class="form-group">
          <label>Username</label>
          <input type="text" id="name" name="name" value="<%= user.name %>">
          <p class="error" id="nameError"></p>
        </div>

        <!-- EMAIL -->
        <div class="form-group">
          <label>Email</label>
          <input type="text" id="email" name="email" value="<%= user.email %>">
          <p class="error" id="emailError"></p>
        </div>

        <!-- STATUS -->
        <div class="form-group">
          <label>Status</label>
          <select name="status">
            <option value="active" <%= !user.isBlocked ? 'selected' : '' %>>Active</option>
            <option value="blocked" <%= user.isBlocked ? 'selected' : '' %>>Blocked</option>
          </select>
        </div>

        <!-- BUTTONS -->
        <div class="form-actions">
          <a href="/admin/users" class="cancel-btn">Cancel</a>
          <button type="submit" class="add-btn">Update User</button>
        </div>

      </form>

    </div>

  </div>

</div>

<!-- JS VALIDATION -->
<script>
function validateEditUser() {
  let isValid = true;

  const nameInput = document.getElementById("name");
  const emailInput = document.getElementById("email");

  const name = nameInput.value.trim();
  const email = emailInput.value.trim();

  const nameError = document.getElementById("nameError");
  const emailError = document.getElementById("emailError");

  // clear old errors
  nameError.innerText = "";
  emailError.innerText = "";

  // NAME VALIDATION
  if (!name) {
    nameError.innerText = "Name is required";
    nameInput.focus();
    isValid = false;
  }

  // EMAIL VALIDATION
  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  if (!email) {
    emailError.innerText = "Email is required";
    if (isValid) emailInput.focus();
    isValid = false;
  } else if (!emailRegex.test(email)) {
    emailError.innerText = "Enter a valid email";
    if (isValid) emailInput.focus();
    isValid = false;
  }

  return isValid;
}

// REAL-TIME CLEAR
document.getElementById("name").addEventListener("input", () => {
  document.getElementById("nameError").innerText = "";
});

document.getElementById("email").addEventListener("input", () => {
  document.getElementById("emailError").innerText = "";
});
</script>

</body>
</html>