<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit User</title>
  <link rel="stylesheet" href="/css/users.css">
</head>

<body>

<div class="dashboard">

  <!-- SIDEBAR -->
  <div class="sidebar">
    <h3>MENU</h3>
    <ul>
      <li><a href="/admin/dashboard">Dashboard</a></li>
      <li>Products</li>
      <li>Category</li>
      <li>Orders</li>
      <li>Coupon</li>
      <li>Transaction</li>
    </ul>

    <ul class="section">
      <li class="section-title active-section">User Management</li>
      <li><a href="/admin/users">Customers</a></li>
    </ul>

    <ul class="section">
      <li class="section-title">Others</li>
      <li>Settings</li>
      <li>Help</li>
      <li>Logout</li>
    </ul>
  </div>

  <!-- MAIN -->
  <div class="main">

    <div class="form-container">

      <h2>Edit User</h2>

       <% if (error) { %>
          <p class="error-msg"><%= error %></p>
        <% } %>

        <% if (success) { %>
          <p class="success-msg"><%= success %></p>
        <% } %>

       <form action="/admin/edit-user/<%= user._id %>?_method=PUT" method="POST">
        <!-- NAME -->
        <div class="form-group">
          <label>Username</label>
          <input type="text" name="name" value="<%= user.name %>" required>
        </div>

        <!-- EMAIL -->
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" value="<%= user.email %>" required>
        </div>

        <!-- PHONE -->
        <!-- <div class="form-group">
          <label>Phone</label>
          <input type="text" name="phone" value="<%= user.phone || '' %>">
        </div> -->

        <!-- STATUS -->
        <div class="form-group">
          <label>Status</label>
          <select name="status">
            <option value="active" <%= !user.isBlocked ? 'selected' : '' %>>Active</option>
            <option value="blocked" <%= user.isBlocked ? 'selected' : '' %>>Blocked</option>
          </select>
        </div>

        <!-- BUTTONS -->
        <div class="form-actions">
          <a href="/admin/users" class="cancel-btn">Cancel</a>
          <button type="submit" class="add-btn">Update User</button>
        </div>

      </form>

    </div>

  </div>

</div>

</body>
</html>