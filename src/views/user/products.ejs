<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <title>Products</title>

  <link rel="stylesheet" href="/css/layout.css">

  <link rel="stylesheet" href="/css/products.css">

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  />

</head>

<body>

  <%- include("../partials/header",{ user:user }) %>

  <!-- sidebar -->
  <div class="page-layout">

  <%- include('../partials/user-sidebar') %>

  <div class="page-content">


  <div class="products-page">

    <!-- LEFT FILTER -->

    <aside class="filter-section">

      <h3>Categories</h3>

      <ul>

        <li>

          <a href="/products">
            All Products
          </a>

        </li>

        <% categories.forEach(function(categoryItem){ %>

          <li>

            <!-- <a
              href="/products?category=<%= categoryItem._id %>&search=<%= search %>&sort=<%= sort %>"
            >
              <%= categoryItem.name %>
            </a> -->

             <a
              href="/products?category=<%= categoryItem._id %>&search=<%= search %>&sort=<%= sort %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>"
              class="<%= category == categoryItem._id.toString()
              ? 'active-category'
              : '' %>"
            >
              <%= categoryItem.name %>
            </a>

          </li>

        <% }) %>

      </ul>

      <hr>

      <h3>Price Filter</h3>

      <form
        action="/products"
        method="GET"
        class="price-form"
      >

        <input
          type="number"
          name="minPrice"
          placeholder="Min Price"
          value="<%= minPrice %>"
        >

        <input
          type="number"
          name="maxPrice"
          placeholder="Max Price"
          value="<%= maxPrice %>"
        >

        <input
          type="hidden"
          name="search"
          value="<%= search %>"
        >

        <input
          type="hidden"
          name="sort"
          value="<%= sort %>"
        >

        <button type="submit">
          Apply
        </button>

      </form>

    </aside>

    <!-- RIGHT PRODUCTS -->

    <div class="products-section">

      <h1 class="products-title">
        Products
      </h1>

     <!-- TOP BAR -->

<div class="top-bar">

  <div class="search-sort-wrapper">

    <!-- SEARCH -->

    <form
      action="/products"
      method="GET"
      class="search-form"
    >

      <input
        type="text"
        name="search"
        placeholder="Search products"
        value="<%= search %>"
      >

      <input
        type="hidden"
        name="category"
        value="<%= category %>"
      >

      <input
        type="hidden"
        name="sort"
        value="<%= sort %>"
      >

      <input
        type="hidden"
        name="minPrice"
        value="<%= minPrice %>"
      >

      <input
        type="hidden"
        name="maxPrice"
        value="<%= maxPrice %>"
      >

      <button type="submit">
        Search
      </button>

      <% if(search){ %>

        <a href="/products">

          <button
            type="button"
            class="clear-btn"
          >
            Clear
          </button>

        </a>

      <% } %>

    </form>

    <!-- SORT -->

    <form
      action="/products"
      method="GET"
      class="sort-form"
    >

      <input
        type="hidden"
        name="search"
        value="<%= search %>"
      >

      <input
        type="hidden"
        name="category"
        value="<%= category %>"
      >

      <input
        type="hidden"
        name="minPrice"
        value="<%= minPrice %>"
      >

      <input
        type="hidden"
        name="maxPrice"
        value="<%= maxPrice %>"
      >

      <select
        name="sort"
        onchange="this.form.submit()"
      >

        <option value="">
          Sort
        </option>

        <option
          value="lowToHigh"
          <%= sort==="lowToHigh" ? "selected" : "" %>
        >
          Price Low To High
        </option>

        <option
          value="highToLow"
          <%= sort==="highToLow" ? "selected" : "" %>
        >
          Price High To Low
        </option>

        <option
          value="aToZ"
          <%= sort==="aToZ" ? "selected" : "" %>
        >
          A-Z
        </option>

        <option
          value="zToA"
          <%= sort==="zToA" ? "selected" : "" %>
        >
          Z-A
        </option>

      </select>

    </form>

  </div>

</div>

     
    <!-- PRODUCTS GRID -->

<div class="products-grid">

  <% if(products.length > 0){ %>

    <% products.forEach(function(product){ %>

      <div class="product-card">

        <a
          href="/products/<%= product._id %>"
          class="product-link"
        >

          <img
            src="/images/<%= product.images[0] %>"
            alt="<%= product.name %>"
          >

          <h3>
            <%= product.name %>
          </h3>

          <p>
            ₹ <%= product.price %>
          </p>

        </a>

        <div class="product-actions">

          <% if(product.stock > 0){ %>

            <div class="cart-section">

              <a
                href="/cart/add/<%= product._id %>"
                class="cart-btn"
              >
                Add To Cart
              </a>


            </div>

          <% } else { %>

            <button
              class="out-stock-btn"
              disabled
            >
              Out Of Stock
            </button>

          <% } %>

          <a
            href="/wishlist/add/<%= product._id %>"
            class="wishlist-btn"
          >
            <i class="fa-regular fa-heart"></i>
          </a>

        </div>

      </div>

    <% }) %>

  <% } else { %>

    <h2 class="no-products">
      No products found
    </h2>

  <% } %>

</div>
  
<!-- PAGINATION -->

  <div class="pagination">

    <% if(currentPage > 1){ %>

      <a
        href="/products?page=<%= currentPage - 1 %>&search=<%= search %>&sort=<%= sort %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>"
      >
        Prev
      </a>

    <% } %>

    <% for(let i=1;i<=totalPages;i++){ %>

      <a
        href="/products?page=<%= i %>&search=<%= search %>&sort=<%= sort %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>"

        class="<%= currentPage === i ? 'active-page' : '' %>"
      >
        <%= i %>
      </a>

    <% } %>

    <% if(currentPage < totalPages){ %>

      <a
        href="/products?page=<%= currentPage + 1 %>&search=<%= search %>&sort=<%= sort %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>"
      >
        Next
      </a>

    <% } %>

  </div>

   </div>

</div>

  <%- include("../partials/footer") %>

</body>

</html>