<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Reset Password</title>
  <link rel="stylesheet" href="/css/reset.css">
</head>
<body>

<div class="wrapper">
  <div class="card">

    <h2>New Password</h2>

    <label>Enter New Password</label>
    <input type="password" id="password" placeholder="min 6 char">

    <label>Confirm Password</label>
    <input type="password" id="confirm" placeholder="******">

    <p id="error" class="error"></p>
    <p id="success" style="color: green; text-align:center; margin-top:10px;"></p>

    <button class="btn" onclick="resetPassword()">continue</button>
    <button class="cancel" onclick="goBack()">cancel</button>

  </div>
</div>

<script>
async function resetPassword() {
  const password = document.getElementById("password").value;
  const confirm = document.getElementById("confirm").value;

  if (!password || !confirm) {
    document.getElementById("error").innerText = "All fields required";
    return;
  }

  if (password.length < 6) {
    document.getElementById("error").innerText = "Password must be at least 6 characters";
    return;
  }

  if (password !== confirm) {
    document.getElementById("error").innerText = "Passwords do not match";
    return;
  }

  const email = localStorage.getItem("email");

  if (!email) {
  document.getElementById("error").innerText = "Session expired. Please try again.";
  setTimeout(() => {
    window.location.href = "/forgot-password";
  }, 2000);
  return;
}

  const res = await fetch("/reset-password", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ email, password })
  });

  const data = await res.json();

 if (res.ok) {
  document.getElementById("success").innerText = "Password updated successfully";

  // clear error if any
  document.getElementById("error").innerText = "";

  // clear storage
  localStorage.removeItem("email");
  localStorage.removeItem("type");

  // redirect after 2 sec
  setTimeout(() => {
    window.location.href = "/login";
  }, 2000);
} else {
    document.getElementById("error").innerText = data.message;
  }
}

function goBack() {
  window.location.href = "/login";
}
</script>

</body>
</html>