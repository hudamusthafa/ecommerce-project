<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Profile</title>
  
  <link rel="stylesheet" href="/css/profile.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>

<!-- header-->
<%- include('../partials/header') %>

<div class="profile-page">

  <h2>My Profile</h2>

  <div class="profile-card">

<form action="/profile/update" method="POST" enctype="multipart/form-data">
    <!-- PROFILE IMAGE -->
<img 
id="profilePreview"
  src="<%= user.profileImage && user.profileImage !== '' 
          ? user.profileImage 
          : '/images/default-avatar.png' %>" 
  class="profile-img"
>

<br><br>

<label for="imageUpload" class="upload-btn">Add Profile</label>
<input type="file" id="imageUpload" name="image" accept="image/*" hidden>

    

    <!-- NAME -->
    <label>Name</label>
    <input type="text" name="name" value="<%= user.name %>" required>

    <!-- EMAIL -->
    <label>Email</label>
    <input type="email" name="email" value="<%= user.email %>" required>

    <!-- PHONE -->
    <!-- <label>Phone Number</label>
    <input type="text" name="phone" value="<%= user.phone || '' %>" placeholder="+91xxxxxxxxxx"> -->

    <!-- GENDER -->
    <label>Gender</label>
    <div class="gender-box">
      <label>
        <input type="radio" name="gender" value="female"
          <%= user.gender === 'female' ? 'checked' : '' %> > Female
      </label>

      <label>
        <input type="radio" name="gender" value="male"
          <%= user.gender === 'male' ? 'checked' : '' %> > Male
      </label>
    </div>

    <!-- SAVE BUTTON -->
    <button type="submit" class="save-btn">Save Changes</button>

  </form>

  </form>

<div class="profile-actions">
  <a href="/checkout" class="address-btn">Manage Address</a>
</div>

</div>

  <!-- EDIT PROFILE -->
  <div class="edit-section">

    

  </div>

  <!-- CHANGE PASSWORD -->
  <div class="password-section">

    <h3>Change Password</h3>

     <% if (typeof message !== 'undefined' && message) { %>
    <p style="color: green; margin-bottom: 10px;"><%= message %></p>
  <% } %>

    <form action="/profile/password" method="POST">

      <input type="password" name="currentPassword" placeholder="Current Password">

      <input type="password" name="newPassword" placeholder="New Password">

      <input type="password" name="confirmPassword" placeholder="Confirm Password">


    <button type="submit" class="password-btn">
  Change Password
</button>
    </form>

  </div>

</div>

<!-- FOOTER -->
<%- include('../partials/footer') %>

<script>
const imageInput = document.getElementById("imageUpload");
const preview = document.getElementById("profilePreview");

imageInput.addEventListener("change", function () {
  const file = this.files[0];

  if (file) {
    const reader = new FileReader();

    reader.onload = function (e) {
      preview.src = e.target.result; 
      
    };

    reader.readAsDataURL(file);
  }
});
</script>

</body>
</html>