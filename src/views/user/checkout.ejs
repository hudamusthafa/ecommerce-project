async function applyCoupon() {

  const couponCode = document.getElementById("couponCode").value.trim();

  if(!couponCode){
    showToast("Please enter a coupon code.", "warning");
    return;
  }

  try {

    const response = await fetch("/checkout/apply-coupon", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ couponCode })
    });

    const data = await response.json();

    if(!data.success){
      showToast(data.message, "warning");
      return;
    }

    // ✅ Show success toast
    showToast("Coupon applied! You saved ₹" + data.discount, "success");

    // ✅ Update discount and total amounts
    document.getElementById("discountAmount").innerText = "₹" + data.discount;
    document.getElementById("totalAmount").innerText = "₹" + data.total;

    // ✅ Hide coupon input box
    document.querySelector(".coupon-form").style.display = "none";
    document.querySelector(".view-coupon-btn").style.display = "none";

    // ✅ Show applied coupon section
    document.getElementById("appliedCouponSection").style.display = "flex";
    document.getElementById("appliedCouponCode").innerText = data.coupon.code;
    document.getElementById("appliedCouponSaving").innerText = "You saved ₹" + data.discount;

  } catch(err) {
    showToast("Something went wrong.", "warning");
  }

}
