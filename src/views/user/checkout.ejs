<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Checkout</title>
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/checkout.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body>

<%- include("../partials/header") %>

<div class="page-layout">

  <%- include('../partials/user-sidebar') %>

  <div class="page-content">

    <div class="checkout-page">

      <h2 class="checkout-title">Checkout</h2>

      <% if(removedProducts && removedProducts.length > 0){ %>
      <div class="checkout-warning">
        <strong>Some products are currently out of stock and have been removed from your checkout:</strong>
        <ul>
          <% removedProducts.forEach(function(product){ %>
            <li><%= product %></li>
          <% }) %>
        </ul>
        <p>Please review your order before placing it.</p>
      </div>
      <% } %>

      <% if(error){ %>
      <div class="checkout-error">
        <%= error %>
      </div>
      <% } %>

      <form action="/checkout/place-order" method="POST">

        <div class="checkout-container">

          <div class="left-section">

            <h3>Delivery Address</h3>

            <% if(user.address && user.address.length > 0){ %>

                  <input
                      type="hidden"
                      name="selectedAddress"
                      id="selectedAddress"
                      value="<%= user.address[0]._id %>"
                  >

                  <div class="address-dropdown">

    <div
        class="selected-address"
        onclick="toggleAddressDropdown()"
    >

        <div id="selectedAddressCard">

            <h4>
                <h4>

                  Address 1

                  <span class="default-badge">
                      Default
                  </span>

              </h4>

              <p>
                  <strong>
                      <%= user.address[0].fullName %>
                  </strong>
              </p>

            </h4>

            <p>
                <%= user.address[0].house %>,
                <%= user.address[0].area %>
            </p>

            <p>
                <%= user.address[0].city %>,
                <%= user.address[0].state %> -
                <%= user.address[0].pincode %>
            </p>

            <p>
                Phone :
                <%= user.address[0].phone %>
            </p>

        </div>

        <i class="fa-solid fa-chevron-down"></i>

    </div>

<!-- address dropdown -->

    <div
        id="addressDropdown"
        class="dropdown-list"
    >

        <% user.address.forEach(function(addr,index){ %>

            <div
                class="dropdown-item"
                onclick="selectAddress(
                    '<%= addr._id %>',
                    this
                )"
            >

                <strong>
                    Address <%= index + 1 %>
                </strong>

                <% if(index === 0){ %>
                <span class="default-badge">Default</span>
                <% } %>

                <p><%= addr.fullName %></p>

                <p>
                    <%= addr.house %>,
                    <%= addr.area %>
                </p>

                <p>
                    <%= addr.city %>,
                    <%= addr.state %> -
                    <%= addr.pincode %>
                </p>

                <p>
                    Phone :
                    <%= addr.phone %>
                </p>

            </div>

        <% }) %>

    </div>

</div>

                  <% }else{ %>

                  <div class="empty-checkout">

                      <p>No address found.</p>

                  </div>

                  <% } %>



            <button
                type="button"
                class="add-address-btn"
                onclick="toggleAddressForm()"
                >

                <i class="fa-solid fa-plus"></i>

                Add New Address

                </button>

            <div id="addressForm" class="checkout-address-form" style="display:none;">
              <div class="form-row">
                <div class="form-group">
                  <label for="fullName">Full Name</label>
                  <input type="text" id="fullName" name="fullName" required>
                </div>
                <div class="form-group">
                  <label for="phone">Phone Number</label>
                  <input type="text" id="phone" name="phone" required>
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="pincode">Pincode</label>
                  <input type="text" id="pincode" name="pincode" required>
                </div>
                <div class="form-group">
                  <label for="email">Email</label>
                  <input type="email" id="email" name="email">
                </div>
              </div>

              <div class="form-group full">
                <label for="house">Address</label>
                <textarea id="house" name="house" rows="3" required></textarea>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="state">State</label>
                  <input type="text" id="state" name="state" required>
                </div>
                <div class="form-group">
                  <label for="city">City</label>
                  <input type="text" id="city" name="city" required>
                </div>
              </div>

              <div class="form-group full">
                <label for="area">Landmark</label>
                <input type="text" id="area" name="area" placeholder="Nearby landmark">
              </div>

              <div class="form-group full">
                <label>Address Type</label>
                <div class="radio-group">
                  <label>
                    <input type="radio" name="type" value="home" checked> Home
                  </label>
                  <label>
                    <input type="radio" name="type" value="work"> Work
                  </label>
                </div>
              </div>

              <button type="button" class="save-btn" onclick="saveAddress()">
                Save Address
              </button>
            </div>

<!-- payment section -->

            <div class="payment-section">

    <h3>Payment Method</h3>

    <div class="payment-card">

        <label class="payment-option">

            <input
                type="radio"
                name="paymentMethod"
                value="COD"
                checked
            >

            <div class="payment-icon">

                <i class="fa-solid fa-money-bill-wave"></i>

            </div>

            <div class="payment-info">

                <h4>Cash On Delivery (COD)</h4>


            </div>

        </label>

    </div>

</div>

<!-- order summary -->

          </div>

          <div class="right-section">
            <h4>Order Summary</h4>

            <% cart.items.forEach(function(item){ %>
              <% if(item.product){ %>
                <div class="summary-product">
                  <img src="/images/<%= item.product.images[0] %>" alt="<%= item.product.name %>">
                  <div class="summary-product-info">
                    <h5><%= item.product.name %></h5>
                    <p>Qty : <%= item.quantity %></p>
                    <p>
                      ₹ <%= item.product.price %> × <%= item.quantity %> = ₹ <%= item.product.price * item.quantity %>
                    </p>
                  </div>
                </div>
              <% } %>
            <% }) %>

            <div class="summary-row">
              <span>Subtotal</span>
              <span>₹<%= subtotal %></span>
            </div>

            <div class="summary-row">
              <span>Shipping</span>
              <span>₹<%= shipping %></span>
            </div>

            <div class="summary-row">
              <span>Discount</span>
              <span>₹<%= discount %></span>
            </div>

            <div class="summary-row order-total">
              <span>Total</span>
              <span>₹<%= total %></span>
            </div>





          <button
            type="submit"
            class="place-order-btn"
        >
            <i class="fa-solid fa-lock"></i>
            Place Order
        </button>

          </div> 
        </div> 
      </form>

<!-- feature cards -->

<div class="checkout-features">

    <div class="feature-card">
        <i class="fa-solid fa-shield-halved"></i>
        <h4>Secure Payment</h4>
        <p>100% protected checkout</p>
    </div>

    <div class="feature-card">
        <i class="fa-solid fa-rotate-left"></i>
        <h4>Easy Returns</h4>
        <p>Simple return process</p>
    </div>

    <div class="feature-card">
        <i class="fa-solid fa-headset"></i>
        <h4>24/7 Support</h4>
        <p>We're always here to help</p>
    </div>

    <div class="feature-card">
        <i class="fa-solid fa-truck-fast"></i>
        <h4>Fast Delivery</h4>
        <p>Quick & reliable shipping</p>
    </div>

</div>



    </div>

  </div>

</div>

<%- include("../partials/footer") %>

<div id="deleteModal" class="modal">
  <div class="modal-content">
    <p>Delete this address?</p>
    <div class="modal-actions">
      <button class="cancel-btn" onclick="closeModal()">Cancel</button>
      <button class="confirm-btn" onclick="confirmDelete()">Delete</button>
    </div>
  </div>
</div>

<script>
let selectedAddressId = null;

function openDeleteModal(id){
  selectedAddressId = id;
  document.getElementById("deleteModal").style.display = "flex";
}

function closeModal(){
  document.getElementById("deleteModal").style.display = "none";
}

function confirmDelete(){
  fetch("/address/" + selectedAddressId, { method:"DELETE" })
  .then(res=>{
    if(!res.ok){ throw new Error(); }
    location.reload();
  })
  .catch(()=>{
    alert("Failed to delete address");
  });
}


function toggleAddressDropdown(){

    const dropdown =
        document.getElementById("addressDropdown");

    dropdown.style.display =
        dropdown.style.display === "block"
        ? "none"
        : "block";

}

function toggleAddressForm() {
  const form = document.getElementById("addressForm");
  if (form.style.display === "none" || form.style.display === "") {
    form.style.display = "block";
  } else {
    form.style.display = "none";
  }
}

function selectAddress(id, element){

    document.getElementById("selectedAddress").value = id;

    document.getElementById("selectedAddressCard").innerHTML =
        element.innerHTML;

    document.getElementById("addressDropdown").style.display = "none";

}

async function saveAddress() {

    const body = {
        fullName: document.getElementById("fullName").value.trim(),
        phone: document.getElementById("phone").value.trim(),
        pincode: document.getElementById("pincode").value.trim(),
        email: document.getElementById("email").value.trim(),
        house: document.getElementById("house").value.trim(),
        state: document.getElementById("state").value.trim(),
        city: document.getElementById("city").value.trim(),
        area: document.getElementById("area").value.trim(),
        type: document.querySelector('input[name="type"]:checked').value
    };

    if (
        !body.fullName ||
        !body.phone ||
        !body.house ||
        !body.city ||
        !body.state ||
        !body.pincode
    ) {
        alert("Please fill all required fields.");
        return;
    }

    try {

        const res = await fetch("/address?fromCheckout=true", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(body)
        });

        const data = await res.json();

        if (data.success) {
            location.reload();
        } else {
            alert(data.message || "Unable to save address");
        }

    } catch (err) {
        alert("Something went wrong.");
    }
}
</script>

</body>

</html>