<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <title>
    Cart
  </title>

  <link rel="stylesheet" href="/css/layout.css">

  <link rel="stylesheet" href="/css/cart.css">

</head>

<body>

<%- include("../partials/header") %>

<div class="cart-page">

  <div class="cart-container">

    <h2 class="cart-title">
      Cart
    </h2>

    <% if(cart && cart.items.length > 0){ %>

      <!-- TABLE HEADER -->

      <div class="cart-header">

        <span>Product</span>

        <span>Price</span>

        <span>Quantity</span>

        <span>Subtotal</span>

      </div>

      <!-- CART ITEMS -->

      <% cart.items.forEach(function(item){ %>

        <div class="cart-row">

          <!-- PRODUCT -->

          <div class="cart-product">

            <a
              href="/products/<%= item.product._id %>"
            >

              <img
                src="/images/<%= item.product.images[0] %>"
              >

            </a>

            <div>

              <a
                href="/products/<%= item.product._id %>"
                class="cart-product-link"
              >

                <h4>
                  <%= item.product.name %>
                </h4>

              </a>

              <p>
                High Quality Jewellery
              </p>

              <!-- out of stock -->
              <% if(item.product.stock <= 0){ %>

                <p class="out-stock-msg">
                  Out Of Stock
                </p>

              <% } %>


                    <!-- REMOVE -->
          <a
            href="/cart/remove/<%= item.product._id %>"
            class="remove-btn"
          >
            Remove
          </a>

            </div>

          </div>

          <!-- PRICE -->

          <div class="cart-price">

            ₹ <%= item.product.price %>

          </div>

        
          <!-- QUANTITY -->

          <div class="cart-quantity">

              <a href="/cart/update/<%= item.product._id %>?action=decrease" >
                <button>-</button>
              </a>

              <span><%= item.quantity %></span>
                
              

              <a href="/cart/update/<%= item.product._id %>?action=increase" >
                <button>+</button>
              </a>

            </div>

             <!-- error msg -->
          <% if(

              error &&

              productId == item.product._id.toString()

            ){ %>

              <p class="item-error">

                <%= error %>

              </p>

            <% } %>


          <!-- SUBTOTAL -->

          <div class="cart-subtotal">

            ₹ <%= item.product.price * item.quantity %>

          </div>

      
        </div>

      <% }) %>

    

      <!-- TOTAL -->

      <div class="cart-total-box">

        <h3>
          Cart Totals
        </h3>

        <p>

          Total :

          ₹
          <%= cart.items.reduce((total,item)=>

            total + (item.product.price * item.quantity)

          ,0) %>

        </p>

<!-- restrict checkout for out of stock -->

          <%

    const hasOutOfStock=cart.items.some(

      item => item.product.stock <= 0

    );

  %>

  <button

    class="checkout-btn"

    <% if(hasOutOfStock){ %>

      disabled

    <% } %>

  >

    Proceed To Checkout

  </button>

      </div>

    <% } else { %>

      <h2 class="empty-cart">

        Cart is empty

      </h2>

    <% } %>

  </div>

</div>

<!-- FEATURES -->

<div class="cart-features">

  <div class="feature-box">

    <h4>
      Free Delivery
    </h4>

    <p>
      For all orders above ₹999
    </p>

  </div>

  <div class="feature-box">

    <h4>
      7 Days Return
    </h4>

    <p>
      Hassle free returns
    </p>

  </div>

  <div class="feature-box">

    <h4>
      Secure Payment
    </h4>

    <p>
      100% secure checkout
    </p>

  </div>

</div>


<%- include("../partials/footer") %>

</body>
</html>