<!DOCTYPE html>

<html lang="en">
<head>

  <meta charset="UTF-8">

  <title>Cart</title>

  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/cart.css">

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  />

</head>
<body>

<%- include("../partials/header") %>

 <!-- sidebar -->
  <div class="page-layout">

  <%- include('../partials/user-sidebar') %>

  <div class="page-content">


<div class="cart-page">

  <div class="cart-container">

<h2 class="cart-title">Cart</h2>

<% if(hasUnavailableItems){ %>

<div class="cart-error-banner">

  <i class="fa-solid fa-circle-exclamation"></i>

  Some products are no longer available.
  Please remove them before proceeding to checkout.

</div>

<% } %>

<% if(cartUpdated){ %>

<div class="cart-warning">

  <div class="warning-icon">
    <i class="fa-solid fa-circle-exclamation"></i>
  </div>

  <div class="warning-text">

    <h4>Your cart has been updated</h4>

    <p>
      Your cart has been updated.
Some items are now available in limited quantity.
    </p>

  </div>

</div>

<% } %>

<% if(cart && cart.items.length > 0){ %>

  <!-- TABLE HEADER -->
  <div class="cart-header">
    <span>Product</span>
    <span>Price</span>
    <span>Quantity</span>
    <span>Subtotal</span>
  </div>




  <!-- CART ITEMS -->
  <% cart.items.forEach(function(item){ %>

    <% if(!item.product){ return; } %>

    <div class="cart-row">

      <!-- PRODUCT -->
      <div class="cart-product">

        <a href="/products/<%= item.product._id %>">
          <img src="/images/<%= item.product.images[0] %>">
        </a>

        <div>

          <a
            href="/products/<%= item.product._id %>"
            class="cart-product-link"
          >
            <h4><%= item.product.name %></h4>
          </a>

          <p>High Quality Jewellery</p>

          <% if(item.isUnavailable){ %>

          <p class="cart-item-error">
            <i class="fa-solid fa-circle-exclamation"></i>
            <%= item.unavailableReason %>
          </p>

          <% } %>

          <!-- <% if(item.product.stock <= 0){ %>
            <p class="out-stock-msg">
              Out Of Stock
            </p>
          <% } %> -->

          <a
            href="/cart/remove/<%= item.product._id %>"
            class="remove-btn"
          >
            <i class="fa-solid fa-trash"></i>
            Remove
          </a>

        </div>

      </div>

      <!-- PRICE -->
      <div class="cart-price">
        ₹ <%= item.product.price %>
      </div>

      <!-- QUANTITY -->
<div class="cart-quantity">

  <% if(item.isUnavailable){ %>

    <!-- <span class="unavailable-text">
      Unavailable
    </span> -->
    <button disabled>-</button>

  <span><%= item.quantity %></span>

  <button disabled>+</button>


  <% } else { %>

    <a href="/cart/update/<%= item.product._id %>?action=decrease">
      <button>-</button>
    </a>

    <span><%= item.quantity %></span>

    <a href="/cart/update/<%= item.product._id %>?action=increase">
      <button <% if(item.product.stock<=0){ %>disabled<% } %>>
        +
      </button>
    </a>

  <% } %>

</div>
      

      <!-- SUBTOTAL -->
      <div class="cart-subtotal">

        <% if(item.product.stock > 0){ %>

          ₹ <%= item.product.price * item.quantity %>

        <% } else { %>

          ₹ 0

        <% } %>

      </div>

    </div>

  <% }) %>


  
  <!-- AVAILABLE PRODUCT CHECK -->
  <%
const canCheckout =
  cart.items.some(item =>
    item.product &&
    item.product.stock > 0 &&
    !item.isUnavailable
  );
%>

  <!-- TOTAL -->
  <div class="cart-total-box">

    <h3>Cart Totals</h3>

    <p>
      Total : ₹
      <%= cart.items.reduce((total,item)=>{

          if(
            item.product &&
            item.product.stock > 0 &&
            !item.isUnavailable
          ){
            return total + (item.product.price * item.quantity);
          }

          return total;

        },0) %>

    </p>

    <!-- CHECKOUT BUTTON -->
    <% if(canCheckout){ %>

      <a
        href="/checkout"
        class="checkout-btn"
      >
        Proceed To Checkout
      </a>

    <% } else { %>

      <button
        class="checkout-btn"
        disabled
      >
        Proceed To Checkout
      </button>

    <% } %>

  </div>

<% } else { %>

  <h2 class="empty-cart">
    Cart is empty
  </h2>

<% } %>
```

  </div>

</div>

<!-- FEATURES -->

<div class="cart-features">

  <div class="feature-box">
    <h4>Free Delivery</h4>
    <p>For all orders above ₹999</p>
  </div>

  <div class="feature-box">
    <h4>7 Days Return</h4>
    <p>Hassle free returns</p>
  </div>

  <div class="feature-box">
    <h4>Secure Payment</h4>
    <p>100% secure checkout</p>
  </div>

</div>

 </div>

</div>



<%- include("../partials/footer") %>
<script>
  // Prevent back button showing cached cart
  window.addEventListener("pageshow", function(event) {
    if(event.persisted){
      window.location.reload();
    }
  });
</script>

<script>
window.addEventListener("DOMContentLoaded", function(){
  const params = new URLSearchParams(window.location.search);

  if(params.get("msg") === "alreadyInCart"){
    showToast("⚠ Already in cart!", "warning");
  }
});
</script>

</body>
</html>
