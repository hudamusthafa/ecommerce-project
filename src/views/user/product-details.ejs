<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= product.name %></title>
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/product-details.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>

<%- include("../partials/header") %>

<div class="details-page">
  <%- include("../partials/user-sidebar") %>

  <div class="details-content">
    
   
    <div class="breadcrumb">
      <a href="/products">Products</a>
      <span class="divider">/</span>
      <span class="current-item"><%= product.name %></span>
    </div>

    <!-- MAIN PRODUCT  -->
    <div class="product-showcase-box">
      
      <!--  GALLERY -->
      <div class="gallery-column">
        <div class="main-image-frame">
          <img id="mainProductImage" src="/images/<%= product.images[0] %>" onclick="openZoom(this.src)">
        </div>

        <div class="thumbnails-row">
          <% const variantNames = ["Gold Plated", "Silver Plated", "Rose Gold Plated"]; %>
          <% product.images.forEach(function(image, index) { %>
            <div class="thumb-card" onclick="changeVariant(this, '<%= variantNames[index] %>')">
              <img src="/images/<%= image %>" class="thumb-img <%= index === 0 ? 'active' : '' %>">
              <span class="thumb-label"><%= variantNames[index] %></span>
            </div>
          <% }) %>
        </div>
      </div>

      <!--  INFO DETAILS -->
      <div class="info-column">
        <h1 class="product-title"><%= product.name %></h1>

        <!-- RATING & USER REVIEWS -->
        <div class="rating-row">
          <span class="stars-gold">
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-regular fa-star"></i>
          </span>
          <span class="rating-text">4.0 (24 Customer Reviews)</span>
        </div>

        <!-- PRICING -->
        <div class="price-row">
          <% if(product.offerPercentage > 0) { %>
            <span class="current-price">₹<%= product.finalPrice %></span>
            <span class="before-price">₹<%= product.originalPrice %></span>
            <span class="promo-tag"><%= product.offerPercentage %>% OFF</span>
          <% } else { %>
            <span class="current-price">₹<%= product.price %></span>
          <% } %>
        </div>

        <!-- VARIANT SELECTION -->
        <div class="spec-group">
          <label class="spec-title">Finish</label>
          <span id="selectedVariant" class="spec-pill"><%= product.variant || 'Gold Plated' %></span>
        </div>

        <!-- STOCK -->
        <div class="stock-status-row">
          <% if(product.stock > 0) { %>
            <span class="badge-in-stock">In Stock</span>
          <% } else { %>
            <span class="badge-out-stock">Out Of Stock</span>
          <% } %>
        </div>

        <!-- DESCRIPTION -->
        <div class="description-box">
          <p class="summary-paragraph"><%= product.description %></p>
        </div>

        <!-- HIGHLIGHTS -->
        <div class="features-box">
          <h4 class="features-title">Highlights</h4>
          <ul class="features-list">
            <li>Premium Quality Finish</li>
            <li>Skin Friendly Material</li>
            <li>Lightweight Design</li>
            <li>Anti Tarnish Coating</li>
          </ul>
        </div>

        <!-- ACTION BUTTONS ROW -->
        <div class="actions-wrapper">
          <% if(product.stock > 0) { %>
            <div class="button-row-layout">
              <a href="/buy-now/<%= product._id %>" class="btn-buy-now">Buy Now</a>
              
              <button class="btn-add-cart" onclick="addToCart('<%= product._id %>', this)">Add To Cart</button>
              
              <button class="btn-wishlist" onclick="addToWishlist('<%= product._id %>', this)">
                <% if(typeof isWishlisted !== "undefined" && isWishlisted) { %>
                  Wishlisted
                <% } else { %>
                  Add To Wishlist
                <% } %>
              </button>
            </div>
          <% } else { %>
            <button class="btn-out-of-stock" disabled>Out Of Stock</button>
          <% } %>
        </div>

      </div>

    </div>

    <!-- RELATED PRODUCTS SECTION -->
    <div class="related-section-box">
      <h3 class="section-main-heading">Customers Also Viewed (Related Items)</h3>
      <div class="related-items-row">
        <% relatedProducts.forEach(function(item) { %>
          <a href="/products/<%= item._id %>" class="card-link-wrapper">
            <div class="product-mini-card">
              <div class="card-thumbnail-holder">
                <img src="/images/<%= item.images[0] %>">
              </div>
              <h4 class="card-product-title"><%= item.name %></h4>
              <div class="card-price-container">

                    <% if(item.offerPercentage > 0){ %>

                        <span class="card-new-price">
                            ₹<%= item.finalPrice %>
                        </span>

                        <span class="card-old-price">
                            ₹<%= item.originalPrice %>
                        </span>

                        <span class="card-offer-badge">
                            <%= item.offerPercentage %>% OFF
                        </span>

                    <% } else { %>

                        <span class="card-new-price">
                            ₹<%= item.price %>
                        </span>

                    <% } %>

                </div>
            </div>
          </a>
        <% }) %>
      </div>
    </div>

    <!-- USER FEEDBACK  -->
    <div class="reviews-section-box">
      <h3 class="section-main-heading">Customer Feedbacks</h3>
      <div class="reviews-container">
        <!-- Sample Feedback  1 -->
        <div class="review-item">
          <div class="review-header">
            <span class="review-author">Huda Musthafa</span>
            <span class="review-rating-stars">
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
            </span>
          </div>
          <p class="review-comment">Absolutely gorgeous! It looks very premium and doesn't irritate my skin at all. Highly recommend!</p>
        </div>

        <!-- Sample Feedback Item 2 -->
        <div class="review-item">
          <div class="review-header">
            <span class="review-author">Sarah Khan</span>
            <span class="review-rating-stars">
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-regular fa-star"></i>
            </span>
          </div>
          <p class="review-comment">Beautiful shine and lightweight. Perfect for daily wear.</p>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- ZOOM MODAL OVERLAY -->
<div id="zoomModal" class="zoom-overlay-modal">
  <span class="close-modal-btn" onclick="closeZoom()">&times;</span>
  <img id="zoomedImage" class="zoom-target-img">
</div>

<%- include("../partials/footer") %>

<script>

const image = document.getElementById("mainProductImage");
image.addEventListener("mousemove", function(e) {
  const rect = image.getBoundingClientRect();
  const x = ((e.clientX - rect.left) / rect.width) * 100;
  const y = ((e.clientY - rect.top) / rect.height) * 100;
  image.style.transformOrigin = `${x}% ${y}%`;
  image.style.transform = "scale(1.8)";
});
image.addEventListener("mouseleave", function() {
  image.style.transformOrigin = "center";
  image.style.transform = "scale(1)";
});
function openZoom(imageSrc) {
  document.getElementById("zoomModal").style.display = "flex";
  document.getElementById("zoomedImage").src = imageSrc;
}
function closeZoom() {
  document.getElementById("zoomModal").style.display = "none";
}
function changeVariant(element, variantName) {
  const targetImg = element.querySelector('.thumb-img');
  document.getElementById("mainProductImage").src = targetImg.src;
  document.getElementById("selectedVariant").innerText = variantName;
  document.querySelectorAll(".thumb-img").forEach(function(img) {
      img.classList.remove("active");
  });
  targetImg.classList.add("active");
}
function addToCart(productId, btn) {
  fetch("/cart/add/" + productId, { method: "POST" })
  .then(res => res.json())
  .then(data => {
    if(data.success) {
      btn.innerText = "Added ✓";
      btn.style.background = "#5e3e29";
    }
  });
}
function addToWishlist(productId, btn) {
  fetch("/wishlist/add/" + productId, { method: "POST" })
  .then(res => res.json())
  .then(data => {
    if(data.success) {
      btn.innerText = 'Wishlisted';
      btn.style.background = "#fffdf9";
    }
  });
}
</script>
</body>
</html>