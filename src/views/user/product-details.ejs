<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <title>
    <%= product.name %>
  </title>

  <link rel="stylesheet" href="/css/layout.css">

  <link rel="stylesheet" href="/css/product-details.css">

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  >

</head>

<body>

<%- include("../partials/header") %>

<div class="details-page">

  <!-- LEFT SIDEBAR -->
  <%- include("../partials/user-sidebar") %>

  <!-- RIGHT CONTENT -->
  <div class="details-content">

    <!-- BREADCRUMB -->
    <div class="breadcrumb">

      <a href="/products">
        Products
      </a>

      <span>
        /
      </span>

      <span>
        <%= product.name %>
      </span>

    </div>

    <!-- PRODUCT SECTION -->
    <div class="product-details-container">

      <!-- LEFT IMAGES -->
      <div class="product-images">

        <!-- MAIN IMAGE -->
        <div class="main-image">

          <img
            id="mainProductImage"
            src="/images/<%= product.images[0] %>"

            onclick="openZoom(this.src)"
          >

        </div>

        <!-- THUMBNAILS -->
        <div class="thumbnail-images">

         <%
            const variantNames=[
              "Gold Plated",
              "Silver Plated",
              "Rose Gold Plated"
            ];
          %>

          <% product.images.forEach(function(image,index){ %>

            <div class="thumbnail-box">

              <img
                src="/images/<%= image %>"

                onclick="
                  document.getElementById('mainProductImage').src=this.src
                "
              >

              <p class="variant-name">

                <%= variantNames[index] || "Variant" %>

              </p>

            </div>

          <% }) %>

        </div>

      </div>

      <!-- RIGHT DETAILS -->
      <div class="product-info">

        <h1>
          <%= product.name %>
        </h1>

        <!-- RATING -->
        <div class="rating">

          <i class="fa-solid fa-star"></i>

          <i class="fa-solid fa-star"></i>

          <i class="fa-solid fa-star"></i>

          <i class="fa-solid fa-star"></i>

          <i class="fa-regular fa-star"></i>

          <span>
            (4.0)
          </span>

        </div>

        <!-- PRICE -->
        <div class="price-section">

          <h2>
            ₹ <%= product.price %>
          </h2>

          <!-- <span class="old-price">
            ₹ <%= product.price + 500 %>
          </span> -->

          <span class="discount">
            20% OFF
          </span>

        </div>


<!-- STOCK STATUS -->

<div class="stock-info">

  <% if(product.stock > 0){ %>

    <span class="in-stock">

      In Stock

    </span>

  <% } else { %>

    <span class="out-stock">

      Out Of Stock

    </span>

  <% } %>

</div>


 <!-- DESCRIPTION -->
        <p class="description">

          <%= product.description %>

        </p>


        <!-- PRODUCT HIGHLIGHTS -->

<div class="product-highlights">

  <h3>
    Highlights
  </h3>

  <ul>

    <li>
      Premium Quality Finish
    </li>

    <li>
      Skin Friendly Material
    </li>

    <li>
      Lightweight Design
    </li>

    <li>
      Anti Tarnish Coating
    </li>

  </ul>

</div>

        <!-- STOCK -->
        <div class="details-buttons">

  <% if(product.stock > 0){ %>

<!-- buynow button -->

    <a
  href="/buy-now/<%= product._id %>"
  class="buy-now-btn"
>
  Buy Now
</a>

    <a
      href="/cart/add/<%= product._id %>"class="cart-btn">
      Add To Cart
    </a>

            <a
          href="/wishlist/add/<%= product._id %>" class="wishlist-btn">
        


         <% if(typeof isWishlisted !== "undefined" && isWishlisted){ %>

             <i class="fa-solid fa-heart"></i> Wishlisted

          <% } else { %>

            Add To Wishlist

          <% } %>

        </a>


    
  <% } else { %>

    <button
      class="disabled-btn"
      disabled
    >

      Out Of Stock

    </button>

  <% } %>

</div>
       

        
      </div>

    </div>

    <!-- RELATED PRODUCTS -->
    <div class="related-section">

      <h2>
        Related Products
      </h2>

      <div class="related-grid">

        <% relatedProducts.forEach(function(item){ %>

          <a
            href="/products/<%= item._id %>"
            class="related-link"
          >

            <div class="related-card">

              <img
                src="/images/<%= item.images[0] %>"
              >
              

              <h4>
                <%= item.name %>
              </h4>

              <p>
                ₹ <%= item.price %>
              </p>

            </div>

          </a>

        <% }) %>

      </div>

    </div>

  </div>

</div>


<!-- REVIEWS SECTION -->

<div class="reviews-section">

  <h2>
    Customer Reviews
  </h2>

  <div class="review-card">

    <div class="review-stars">

      <i class="fa-solid fa-star"></i>
      <i class="fa-solid fa-star"></i>
      <i class="fa-solid fa-star"></i>
      <i class="fa-solid fa-star"></i>
      <i class="fa-regular fa-star"></i>

    </div>

    <h4>
      Arya
    </h4>

    <p>
      Beautiful quality product. Elegant finish and lightweight design.
    </p>

  </div>

  <div class="review-card">

    <div class="review-stars">

      <i class="fa-solid fa-star"></i>
      <i class="fa-solid fa-star"></i>
      <i class="fa-solid fa-star"></i>
      <i class="fa-solid fa-star"></i>
      <i class="fa-solid fa-star"></i>

    </div>

    <h4>
      Aisha
    </h4>

    <p>
      Worth the price. Looks premium and perfect for daily wear.
    </p>

  </div>

</div>

<!-- IMAGE ZOOM MODAL -->

        <div
          id="zoomModal"
          class="zoom-modal"
        >

          <span
            class="close-zoom"
            onclick="closeZoom()"
          >
            &times;
          </span>

          <img
            id="zoomedImage"
            class="zoomed-image"
          >

        </div>

<%- include("../partials/footer") %>



<script>



const image=document.getElementById("mainProductImage");

image.addEventListener("mousemove",function(e){

  const rect=image.getBoundingClientRect();

  const x=((e.clientX-rect.left)/rect.width)*100;
  const y=((e.clientY-rect.top)/rect.height)*100;

  image.style.transformOrigin=`${x}% ${y}%`;
  image.style.transform="scale(2)";
});

image.addEventListener("mouseleave",function(){

  image.style.transformOrigin="center";
  image.style.transform="scale(1)";
});





  function openZoom(imageSrc){

    document.getElementById("zoomModal").style.display="flex";

    document.getElementById("zoomedImage").src=imageSrc;

  }

  function closeZoom(){

    document.getElementById("zoomModal").style.display="none";

  }

</script>

</body>

</html>