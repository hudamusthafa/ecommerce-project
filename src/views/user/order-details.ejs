<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8">

  <title>Order Details</title>

  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/order-details.css">
  <link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
/>

</head>
<body>

<%- include("../partials/header") %>

<div class="order-details-page">

  <h2 class="page-title">
    Order Details
  </h2>

  <!-- error msg -->
   
  <% if(cancelled){ %>

  <div class="success-message">
    ✓ Order cancelled successfully
  </div>

<% } %>

<!-- ORDER TRACKER -->

<% if(
  order.orderStatus !== "Cancelled" &&
  order.orderStatus !== "Returned"
){ %>

<div class="order-tracker">

  <div class="step <%= ["Placed","Processing","Shipped","Delivered"].includes(order.orderStatus) ? "completed" : "" %>">
    <span>1</span>
    <p>Placed</p>
  </div>

  <div class="line"></div>

  <div class="step <%= ["Processing","Shipped","Delivered"].includes(order.orderStatus) ? "completed" : "" %>">
    <span>2</span>
    <p>Processing</p>
  </div>

  <div class="line"></div>

  <div class="step <%= ["Shipped","Delivered"].includes(order.orderStatus) ? "completed" : "" %>">
    <span>3</span>
    <p>Shipped</p>
  </div>

  <div class="line"></div>

  <div class="step <%= order.orderStatus==="Delivered" ? "completed" : "" %>">
    <span>4</span>
    <p>Delivered</p>
  </div>

</div>

<% } %>

 <!-- PRODUCTS -->

  <div class="products-card">

    <h3>
      Ordered Products
    </h3>

    <% order.items.forEach(function(item){ %>

      <div class="product-row">

        <img
          src="/images/<%= item.product.images[0] %>"
          alt="<%= item.product.name %>"
        >

        <div class="product-info">

          <h4>
            <%= item.product.name %>
          </h4>

          <p>
            Quantity :
            <%= item.quantity %>
          </p>

          <p>
            Price :
            ₹<%= item.price %>
          </p>

        </div>

        <div class="product-total">

          ₹<%= item.price * item.quantity %>

        </div>

      </div>

    <% }) %>

  </div>



  <!-- ORDER INFO -->

  <div class="order-info-card">

    <div>

      <h4>Order ID</h4>

      <p>
        <%= order.orderId %>
      </p>

    </div>

    <div>

      <h4>Order Date</h4>

      <p>
        <%= new Date(order.createdAt).toLocaleDateString() %>
      </p>

    </div>

    <div>

      <h4>Status</h4>

      <p class="order-status">
        <%= order.orderStatus %>
      </p>

    </div>

    <div>

      <h4>Total</h4>

      <p>
        ₹<%= order.total %>
      </p>

    </div>

  </div>


<!-- ORDER ACTIONS(CANCEL/RETURN) -->

<% if(order.orderStatus === "Cancelled"){ %>

  <div class="cancel-order-card">

    <h3>Order Cancelled</h3>

    <p>
      Status : <strong>Cancelled</strong>
    </p>

    <% if(order.cancelReason){ %>

      <p>
        Reason :
        <%= order.cancelReason %>
      </p>

    <% } %>

  </div>

<% } else if(order.orderStatus === "Returned"){ %>

  <div class="cancel-order-card">

    <h3>Order Returned</h3>

    <p>
      Status : <strong>Returned</strong>
    </p>

    <% if(order.returnReason){ %>

      <p>
        Reason :
        <%= order.returnReason %>
      </p>

    <% } %>

  </div>

<% } else if(order.orderStatus === "Delivered"){ %>

  <div class="cancel-order-card">

    <h3>Return Order</h3>

    <form
      action="/orders/<%= order._id %>/return"
      method="POST"
    >

      <textarea
        name="reason"
        placeholder="Reason for return"
        required
      ></textarea>

      <button
        type="submit"
        class="cancel-btn"
      >
        Return Order
      </button>

    </form>

  </div>

<% } else { %>

  <div class="cancel-order-card">

    <h3>Cancel Order</h3>

    <form
      action="/orders/<%= order._id %>/cancel"
      method="POST"
    >

      <textarea
        name="reason"
        placeholder="Reason for cancellation (optional)"
      ></textarea>

      <button
        type="submit"
        class="cancel-btn"
      >
        Cancel Order
      </button>

    </form>

  </div>

<% } %>

  <!-- ADDRESS -->

  <div class="address-card">

    <h3>
      Delivery Address
    </h3>

    <p>
      <strong>
        <%= order.address.fullName %>
      </strong>
    </p>

    <p>
      <%= order.address.house %>
    </p>

    <p>
      <%= order.address.area %>
    </p>

    <p>
      <%= order.address.city %>,
      <%= order.address.state %>
    </p>

    <p>
      PIN : <%= order.address.pincode %>
    </p>

    <p>
      Phone : <%= order.address.phone %>
    </p>

  </div>

 

  <!-- PRICE SUMMARY -->

  <div class="summary-card">

    <div class="summary-row">

      <span>
        Subtotal
      </span>

      <span>
        ₹<%= order.subtotal %>
      </span>

    </div>

    <div class="summary-row">

      <span>
        Shipping
      </span>

      <span>
        ₹<%= order.shipping %>
      </span>

    </div>

    <div class="summary-row">

      <span>
        Discount
      </span>

      <span>
        ₹<%= order.discount %>
      </span>

    </div>

    <div class="summary-row total-row">

      <span>
        Total
      </span>

      <span>
        ₹<%= order.total %>
      </span>

    </div>

  </div>

</div>

<%- include("../partials/footer") %>

</body>
</html>