<!DOCTYPE html>

<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Aura | Home</title>

  <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/home.css">


  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body>

<%- include('../partials/header') %>


<section class="category-strip">

  <a href="/products?category=Bangles" class="category-circle">
    <img src="/images/bangles.png" alt="Bangles">
    <span>BANGLES</span>
  </a>

  <a href="/products?category=Earrings" class="category-circle">
    <img src="/images/earings.png" alt="Earrings">
    <span>EARRINGS</span>
  </a>

  <a href="/products?category=Necklace" class="category-circle">
    <img src="/images/necklace.png" alt="Necklace">
    <span>NECKLACE</span>
  </a>

  <a href="/products?category=Anklets" class="category-circle">
    <img src="/images/anklets.png" alt="Anklets">
    <span>ANKLETS</span>
  </a>

  <a href="/products?category=Rings" class="category-circle">
    <img src="/images/rings.png" alt="Rings">
    <span>RINGS</span>
  </a>

</section>

<!-- HERO SECTION -->

<section class="hero-section">

  <div class="hero-content">

<h1 class="brand-title">
  Aura Jewels
</h1>

<p>
  Premium Anti-Tarnish Jewellery crafted for everyday luxury.
</p>

<div class="hero-features">

  <div class="feature">
    <i class="fa-solid fa-droplet"></i>
    <span>Waterproof</span>
  </div>

  <div class="feature">
    <i class="fa-solid fa-shield"></i>
    <span>Sweat Resistant</span>
  </div>

  <div class="feature">
    <i class="fa-regular fa-gem"></i>
    <span>Hypoallergenic</span>
  </div>

  <div class="feature">
    <i class="fa-solid fa-star"></i>
    <span>Anti Tarnish</span>
  </div>

</div>

<div class="hero-buttons">

  <a href="/products" class="primary-btn">
    Shop Collection
  </a>

  <a href="/products" class="secondary-btn">
    Explore New Arrivals
  </a>

</div>


  </div>

  <div class="hero-image">

<% if(products && products.length > 0){ %>

  <img
    src="/images/<%= products[0].images[0] %>"
    alt="Hero Product"
  >

<% } %>


  </div>

</section>



<!-- SHOP BY CATEGORY -->

<section class="category-section">

  <div class="section-header">
    <h2>Shop By Category</h2>
  </div>

  <div class="category-grid">


<% for(let i = 0; i < Math.min(products.length,5); i++){ %>

  <div class="category-card">

    <img
      src="/images/<%= products[i].images[0] %>"
      alt="<%= products[i].name %>"
    >

    <h4><%= products[i].name %></h4>

  </div>

<% } %>


  </div>

</section>

<!-- BEST SELLERS -->

<section class="best-sellers">

  <div class="section-header">


<div>
  <h2>Best Sellers</h2><br>
  <p>Most Loved By Our Customers</p>
</div>

<a href="/products">
  View All Products
</a>


  </div>

  <div class="product-grid">


<% products.slice(0,4).forEach(product => { %>

  <div class="product-card">

    <img
      src="/images/<%= product.images[0] %>"
      alt="<%= product.name %>"
    >

    <!-- offer badge -->

    <% if(product.offerPercentage > 0){ %>

<div class="product-offer-badge">
  <%= product.offerPercentage %>% OFF
</div>

<% } %>

    <h4><%= product.name %></h4>


  <!-- product offer -->

    <div class="price-box">

  <% if(product.offerPercentage > 0){ %>

    <span class="offer-price">
      ₹<%= product.finalPrice %>
    </span>

    <span class="original-price">
      ₹<%= product.originalPrice %>
    </span>

    <span class="offer-percent">
      <%= product.offerPercentage %>% OFF
    </span>

  <% } else { %>

    <span class="normal-price">
      ₹<%= product.price %>
    </span>

  <% } %>

</div>



    <% if(product.stock > 0){ %>

      <button class="cart-btn">
        Add To Cart
      </button>

    <% } else { %>

      <button
        class="cart-btn out-stock"
        disabled
      >
        Out Of Stock
      </button>

    <% } %>

  </div>

<% }) %>


  </div>

</section>

<!-- why aura -->
<section class="why-aura-mini">

  <h2>Why Choose Aura?</h2>

  <div class="features-grid">

    <div class="feature-box">
      Waterproof
    </div>

    <div class="feature-box">
      Anti Tarnish
    </div>

    <div class="feature-box">
      Skin Friendly
    </div>

    <div class="feature-box">
      Long Lasting Shine
    </div>

  </div>

</section>
<!-- NEW ARRIVALS -->

<section class="best-sellers">

  <div class="section-header">


<div>
  <h2>New Arrivals</h2><br>
  <p>Freshly Added Collections</p>
</div>


  </div>

  <div class="product-grid">


<% products.slice(4,8).forEach(product => { %>

  <div class="product-card">

    <img
      src="/images/<%= product.images[0] %>"
      alt="<%= product.name %>"
    >

    <!-- offer badge -->

<% if(product.offerPercentage > 0){ %>

<div class="product-offer-badge">
  <%= product.offerPercentage %>% OFF
</div>

<% } %>


    <h4><%= product.name %></h4>


    <!-- product offer -->

<div class="price-box">

  <% if(product.offerPercentage > 0){ %>

    <span class="offer-price">
      ₹<%= product.finalPrice %>
    </span>

    <span class="original-price">
      ₹<%= product.originalPrice %>
    </span>

    <span class="offer-percent">
      <%= product.offerPercentage %>% OFF
    </span>

  <% } else { %>

    <span class="normal-price">
      ₹<%= product.price %>
    </span>

  <% } %>

</div>



    <button class="cart-btn">
      Add To Cart
    </button>

  </div>

<% }) %>


  </div>

</section>

<!-- Testimonials -->

<section class="testimonial-section">

  <h2>What People Are Saying</h2>

  <div class="testimonial-grid">

    <div class="testimonial-card">
      <i class="fa-solid fa-quote-left"></i>

      <p>
        Beautiful jewellery and excellent quality.
        The finish is premium and delivery was quick.
        I absolutely love my purchase.
      </p>

      <div class="stars">★★★★★</div>

      <h4>Ranjana</h4>
    </div>

    <div class="testimonial-card">
      <i class="fa-solid fa-quote-left"></i>

      <p>
        Elegant designs and worth every penny.
        The anti-tarnish quality is amazing and
        the jewellery still looks brand new.
      </p>

      <div class="stars">★★★★★</div>

      <h4>Geeta</h4>
    </div>

    <div class="testimonial-card">
      <i class="fa-solid fa-quote-left"></i>

      <p>
        Perfect for daily wear and special occasions.
        Stylish, lightweight and skin friendly.
      </p>

      <div class="stars">★★★★★</div>

      <h4>Sumbul</h4>
    </div>

    <div class="testimonial-card">
      <i class="fa-solid fa-quote-left"></i>

      <p>
        One of the best jewellery purchases I have made.
        Beautiful packaging and premium quality products.
      </p>

      <div class="stars">★★★★★</div>

      <h4>Renuka</h4>
    </div>

  </div>

</section>


<%- include('../partials/footer') %>

</body>
</html>
