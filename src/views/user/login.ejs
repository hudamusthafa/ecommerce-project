<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Login</title>
  <link rel="stylesheet" href="/css/style.css">

  <!-- Font Awesome -->
  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</head>
<body>

<div class="container">

  <!-- LEFT IMAGE -->
  <div class="left">
    <img src="https://images.unsplash.com/photo-1603974372039-adc49044b6bd">
  </div>

  <!-- RIGHT FORM -->
  <div class="right">
    <div class="card">
      <h2>Sign-in</h2>

      <!--  Backend Message -->
      <% if (typeof message !== 'undefined') { %>
        <p style="color:red;"><%= message %></p>
      <% } %>

      <!--  FORM -->
      <form method="POST" action="/api/auth/login">

        <input type="email" name="email" placeholder="Email" required>

        <div class="password-box">
          <input type="password" name="password" id="password" placeholder="Password" required>
          <i class="fas fa-eye" onclick="togglePassword('password', this)"></i>
        </div>

        <div style="text-align:right; font-size:12px; margin-top:5px;">
          <a href="#">Forgot password</a>
        </div>

        <button class="btn" type="submit">Login</button>
      </form>

      <div class="login-link">
        Don’t have an account? <a href="/register">Signup Here</a>
      </div>

    </div>
  </div>

</div>

<script>
function togglePassword(id, icon) {
  const input = document.getElementById(id);
  if (input.type === "password") {
    input.type = "text";
    icon.classList.replace("fa-eye", "fa-eye-slash");
  } else {
    input.type = "password";
    icon.classList.replace("fa-eye-slash", "fa-eye");
  }
}
</script>

</body>
</html>