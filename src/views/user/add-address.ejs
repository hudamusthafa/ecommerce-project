<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Add Address</title>

  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/add-address.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

</head>
<body>

<%- include('../partials/header') %>

<h2 class="page-title">
  <%= address ? "Edit Address" : "Add Address" %>
</h2>
<div class="address-container">

<form
  action="<%= address ? '/address/' + address._id + '?_method=PUT' : '/address' %>"
  method="POST"
>
 
  <!-- ROW 1 -->
  <div class="form-row">
    <div class="form-group">
      <label>Full Name</label>
      <input type="text" name="fullName"
        value="<%= address ? address.fullName : '' %>" required>
    </div>

    <div class="form-group">
      <label>Phone Number</label>
      <input type="text" name="phone"
        value="<%= address ? address.phone : '' %>" required>
    </div>
  </div>

  <!-- ROW 2 -->
  <div class="form-row">
    <div class="form-group">
      <label>Pincode</label>
      <input type="text" name="pincode"
        value="<%= address ? address.pincode : '' %>" required>
    </div>

    <div class="form-group">
      <label>Email</label>
      <input type="email" name="email"
        value="<%= address ? address.email : '' %>">
    </div>
  </div>

  <!-- ADDRESS -->
  <div class="form-group full">
    <label>Address</label>
    <textarea name="house" required><%= address ? address.house : '' %></textarea>
  </div>

  <!-- ROW 3 -->
  <div class="form-row">
    <div class="form-group">
      <label>State</label>
      <input type="text" name="state"
        value="<%= address ? address.state : '' %>" required>
    </div>

    <div class="form-group">
      <label>City</label>
      <input type="text" name="city"
        value="<%= address ? address.city : '' %>" required>
    </div>
  </div>

  <!-- LANDMARK -->
  <div class="form-group full">
    <label>Landmark</label>
    <input type="text" name="area"
      value="<%= address ? address.area : '' %>" placeholder="Nearby landmark">
  </div>

  <!-- TYPE -->
  <div class="form-group full">
    <label>Address Type</label>
    <div class="radio-group">
      <label>
        <input type="radio" name="type" value="home"
          <%= address && address.type === 'home' ? 'checked' : '' %>>
        Home
      </label>

      <label>
        <input type="radio" name="type" value="work"
          <%= address && address.type === 'work' ? 'checked' : '' %>>
        Work
      </label>
    </div>
  </div>

  <!-- BUTTON -->
  <button type="submit" class="save-btn">
    <%= address ? "Update Address" : "Save Address" %>
  </button>

</form>

</div>

<%- include('../partials/footer') %>

</body>
</html>