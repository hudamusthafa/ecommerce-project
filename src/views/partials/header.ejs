<nav class="navbar">

  <!-- LEFT -->
  <div class="logo">
    Aura
  </div>

  <!-- CENTER -->
  <div class="nav-links">

    <a href="/home">Home</a>

    <a href="#">Shop</a>

    <a href="/products">Products</a>

  </div>

  <!-- RIGHT -->
<div class="nav-right">

  <% if(user){ %>

    <span class="welcome">
      Welcome <%= user.name %>
    </span>

    <!-- ACCOUNT DROPDOWN -->
    <div class="account-dropdown">

     <button class="account-btn">
        <i class="fa-solid fa-user"></i>
      </button>

      <div class="account-menu">
        <a href="/profile">Profile</a>
        <a href="/orders">Orders</a>
      </div>

    </div>

    <!-- WISHLIST -->
    <a
      href="/wishlist"
      class="wishlist-icon"
      title="Wishlist"
    >
      <i class="fa-regular fa-heart"></i>
    </a>

    <!-- CART -->
    <a
      href="/cart"
      class="cart-icon"
      title="Cart"
    >
      <i class="fa-solid fa-cart-shopping"></i>

      <% if(cartCount > 0){ %>
        <span class="cart-badge">
          <%= cartCount %>
        </span>
      <% } %>

    </a>

    <!-- LOGOUT -->
    <a href="/logout" class="logout">
      Log Out
    </a>

  <% } else { %>

    <a href="/login" class="login-btn">
      Login
    </a>

    <a href="/register" class="signup-btn">
      Sign Up
    </a>

  <% } %>

</div>
</nav>